{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lorethra:contract-registry:v1",
  "title": "Lorethra Contract Registry",
  "type": "object",
  "required": ["registry_version", "contracts"],
  "properties": {
    "registry_version": { "const": 1 },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "kind", "status", "path", "owner", "consumers"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "kind": { "enum": ["json-schema", "openapi"] },
          "status": { "enum": ["current-shape", "design-only"] },
          "path": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "consumers": { "type": "array", "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
