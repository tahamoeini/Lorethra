{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lorethra:common:v1",
  "title": "Lorethra Shared Contract Definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Opaque, case-sensitive identifier. Scope comes from its containing workspace/branch fields; clients must not treat it as a path."
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "RFC 3339 timestamp normalized to UTC with a Z suffix."
    },
    "provenance": {
      "type": "object",
      "required": ["origin"],
      "properties": {
        "origin": { "type": "string", "minLength": 1, "maxLength": 80 },
        "source_id": { "$ref": "urn:lorethra:common:v1#/$defs/identifier" },
        "source_revision": { "type": "integer", "minimum": 0 },
        "source_turn_id": { "$ref": "urn:lorethra:common:v1#/$defs/identifier" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "recorded_at": { "$ref": "urn:lorethra:common:v1#/$defs/utcTimestamp" }
      },
      "additionalProperties": true
    }
  }
}
