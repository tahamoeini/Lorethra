n}\n.brand-mark {\n  width: 31px;\n  height: 31px;\n  border: 1px solid #5f9180;\n  border-radius: 10px;\n  color: var(--mint);\n  display: grid;\n  place-items: center;\n  font-family: Manrope, sans-serif;\n  font-weight: 800;\n  font-size: 19px;\n  box-shadow: inset 0 0 16px #47705b30;\n}\n.brand strong {\n  display: block;\n  font-family: Manrope, sans-serif;\n  font-size: 13px;\n  letter-spacing: 0.01em;\n}\n.brand span {\n  display: block;\n  margin-top: 3px;\n  color: #71807d;\n  letter-spacing: 0.19em;\n  font-size: 8px;\n}\n.workspace-label {\n  padding: 0 12px 9px;\n  font-size: 9px;\n  font-weight: 700;\n  color: #72807e;\n  letter-spacing: 0.14em;\n}\n.workspace-select,\n.field-label select,\n.field-label input {\n  width: 100%;\n  height: 39px;\n  background: #1a2224;\n  color: var(--text);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 0 10px;\n  outline: none;\n}\n.workspace-select {\n  margin-bottom: 28px;\n  font-size: 12px;\n}\n.primary-nav {\n  display: grid;\n  gap: 5px;\n}\n.nav-item {\n  border: 0;\n  background: transparent;\n  color: #a8b3b1;\n  text-align: left;\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  padding: 11px 12px;\n  border-radius: 10px;\n}\n.nav-item:hover {\n  background: #1a2224;\n}\n.nav-item.active {\n  background: #1c2a27;\n  color: var(--mint);\n  box-shadow: inset 2px 0 #84c5a8;\n}\n.nav-icon {\n  width: 18px;\n  text-align: center;\n  font-size: 16px;\n  color: #83928f;\n}\n.active .nav-icon {\n  color: var(--mint);\n}\n.nav-item b {\n  display: block;\n  font-size: 12px;\n  font-weight: 600;\n}\n.nav-item small {\n  display: block;\n  color: #73817e;\n  font-size: 10px;\n  margin-top: 4px;\n}\n.sidebar-bottom {\n  margin-top: auto;\n  border-top: 1px solid var(--line);\n  padding: 16px 11px 0;\n  color: #98a5a3;\n  font-size: 10px;\n}\n.privacy-dot {\n  display: inline-block;\n  width: 6px;\n  height: 6px;\n  border-radius: 99px;\n  background: #85c7a7;\n  margin-right: 7px;\n  vertical-align: middle;\n  box-shadow: 0 0 8px #85c7a780;\n}\n.sidebar-version {\n  float: right;\n  color: #697572;\n}\n.main-area {\n  grid-column: 2;\n  min-width: 0;\n}\n.topbar {\n  height: 62px;\n  border-bottom: 1px solid #283032b0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 42px;\n}\n.breadcrumbs,\n.top-actions {\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  font-size: 11px;\n  color: #b3bfbd;\n}\n.crumb-sep {\n  color: #62706d;\n}\n.branch-pill,\n.revision-chip {\n  border: 1px solid var(--line);\n  background: #171e20;\n  color: #aab7b4;\n  border-radius: 6px;\n  padding: 5px 8px;\n  font-size: 10px;\n}\n.top-actions {\n  gap: 14px;\n}\n.quiet-button {\n  border: 0;\n  background: transparent;\n  color: #a5b3af;\n  padding: 7px 9px;\n  font-size: 11px;\n}\n.quiet-button:hover {\n  color: var(--mint);\n}\n.page-content {\n  max-width: 1430px;\n  margin: auto;\n  padding: 29px 42px 70px;\n}\n.notice {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  border: 1px solid #2e433d;\n  background: #17231f;\n  color: #c6d8d2;\n  border-radius: 9px;\n  padding: 10px 12px;\n  font-size: 11px;\n  margin-bottom: 24px;\n}\n.notice > span {\n  color: var(--mint);\n  font-weight: 700;\n}\n.notice.error {\n  border-color: #52312f;\n  background: #281a1a;\n  color: #efc0bb;\n}\n.notice.error > span {\n  color: var(--red);\n}\n.notice > button {\n  margin-left: auto;\n  border: 0;\n  background: none;\n  color: inherit;\n  font-size: 17px;\n}\n.page-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  gap: 25px;\n  margin: 2px 0 25px;\n}\n.eyebrow {\n  font-size: 9px;\n  color: #8caa9c;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  font-weight: 700;\n}\n.page-heading h1,\n.welcome-card h1 {\n  font:\n    700 30px/1.2 Manrope,\n    sans-serif;\n  letter-spacing: -0.04em;\n  margin: 8px 0 7px;\n}\n.page-heading p,\n.welcome-card p {\n  margin: 0;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.65;\n}\n.metric-row {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(120px, 1fr));\n  gap: 12px;\n  margin-bottom: 20px;\n}\n.metric-card {\n  min-height: 80px;\n  background: #171d1f;\n  border: 1px solid var(--line);\n  border-radius: 11px;\n  display: flex;\n  align-items: center;\n  gap: 13px;\n  padding: 15px 17px;\n}\n.metric-icon {\n  width: 30px;\n  height: 30px;\n  border-radius: 9px;\n  display: grid;\n  place-items: center;\n  color: #a8c6b8;\n  background: #24312d;\n  font-size: 15px;\n}\n.metric-card strong {\n  font:\n    700 19px Manrope,\n    sans-serif;\n  display: block;\n}\n.metric-card small {\n  display: block;\n  color: #8c9996;\n  font-size: 10px;\n  margin-top: 2px;\n}\n.metric-accent .metric-icon {\n  color: #e1bd83;\n  background: #332b20;\n}\n.metric-accent strong {\n  color: #e9ca90;\n}\n.toolbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin: 7px 0 15px;\n}\n.tabs {\n  display: flex;\n  gap: 3px;\n  border-bottom: 1px solid var(--line);\n}\n.tabs button {\n  background: none;\n  border: 0;\n  color: #84918e;\n  font-size: 11px;\n  padding: 11px 13px;\n  border-bottom: 2px solid transparent;\n  margin-bottom: -1px;\n}\n.tabs button.selected {\n  color: var(--mint);\n  border-bottom-color: #8dc4a7;\n}\n.search-box {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  height: 34px;\n  padding: 0 10px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: #151b1d;\n  color: #8b9996;\n  width: 225px;\n}\n.search-box input {\n  width: 100%;\n  background: transparent;\n  border: 0;\n  outline: none;\n  color: var(--text);\n  font-size: 10px;\n}\n.knowledge-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.65fr) minmax(245px, 0.82fr);\n  gap: 14px;\n}\n.panel {\n  border: 1px solid var(--line);\n  background: linear-gradient(150deg, #192022, #161c1e 70%);\n  border-radius: var(--radius);\n  padding: 17px;\n  min-width: 0;\n}\n.panel-heading {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 15px;\n}\n.panel-heading h2 {\n  font:\n    600 13px Manrope,\n    sans-serif;\n  margin: 0;\n  letter-spacing: -0.015em;\n}\n.panel-heading p {\n  font-size: 10px;\n  color: #879390;\n  margin: 5px 0 0;\n  line-height: 1.5;\n}\n.panel-count {\n  font-size: 9px;\n  color: #a2b3ad;\n  border: 1px solid #34423d;\n  border-radius: 20px;\n  padding: 4px 8px;\n  white-space: nowrap;\n}\n.graph-panel {\n  min-height: 355px;\n  display: flex;\n  flex-direction: column;\n}\n.graph-canvas {\n  height: 275px;\n  width: 100%;\n  overflow: hidden;\n}\n.graph-canvas svg {\n  width: 100%;\n  height: 100%;\n}\n.edge {\n  stroke: #76a992;\n  stroke-width: 1.3;\n  opacity: 0.78;\n}\n.edge.proposed {\n  stroke: #c4a46e;\n  stroke-dasharray: 5 5;\n  opacity: 0.7;\n}\n.edge-label {\n  fill: #a7b5b1;\n  font-size: 9px;\n  text-anchor: middle;\n  paint-order: stroke;\n  stroke: #171d1f;\n  stroke-width: 4px;\n  stroke-linejoin: round;\n}\n.node-circle {\n  fill: #243a33;\n  stroke: #85bea1;\n  stroke-width: 1.3;\n}\n.node-label {\n  fill: #d7e0dc;\n  text-anchor: middle;\n  font-size: 10px;\n}\n.graph-empty {\n  height: 265px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-direction: column;\n  color: #84938f;\n  gap: 9px;\n}\n.graph-empty span {\n  font-size: 24px;\n  color: #76a992;\n}\n.graph-empty strong {\n  font: 600 12px Manrope;\n  color: #b8c4c0;\n}\n.graph-empty small {\n  font-size: 10px;\n  color: #788682;\n}\n.graph-legend {\n  display: flex;\n  gap: 18px;\n  padding: 7px 4px 0;\n  border-top: 1px solid #293234;\n  color: #86938f;\n  font-size: 9px;\n  margin-top: auto;\n}\n.graph-legend span {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n.legend-node {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: #77ad93;\n}\n.legend-line {\n  width: 15px;\n  height: 1px;\n  background: #76a992;\n}\n.legend-line.proposed {\n  background: repeating-linear-gradient(\n    90deg,\n    #c4a46e 0 4px,\n    transparent 4px 7px\n  );\n}\n.stacked-panels {\n  display: grid;\n  gap: 14px;\n  align-content: start;\n}\n.compact-form {\n  padding: 16px;\n}\n.compact-form .panel-heading {\n  margin-bottom: 12px;\n}\n.compact-form form {\n  display: grid;\n  gap: 10px;\n}\n.compact-form label,\n.field-label {\n  display: grid;\n  gap: 5px;\n  color: #95a19e;\n  font-size: 9px;\n}\n.compact-form input,\n.compact-form select,\n.compact-form textarea,\n.claim-form input,\n.claim-form select,\n.inline-create input {\n  width: 100%;\n  border: 1px solid #303a3c;\n  background: #111719;\n  color: var(--text);\n  border-radius: 7px;\n  padding: 9px 10px;\n  outline: none;\n  font-size: 10px;\n}\n.compact-form input:focus,\n.compact-form select:focus,\n.compact-form textarea:focus,\n.claim-form input:focus,\n.claim-form select:focus,\n.inline-create input:focus {\n  border-color: #5d8b76;\n}\n.compact-form input[type=\"file\"] {\n  padding: 8px;\n  font-size: 9px;\n}\n.compact-form select {\n  color: #dce5e1;\n}\n.compact-form textarea {\n  resize: vertical;\n  line-height: 1.55;\n}\n.primary-button,\n.secondary-button {\n  display: inline-flex;\n  justify-content: center;\n  align-items: center;\n  gap: 10px;\n  border-radius: 8px;\n  padding: 10px 13px;\n  font-size: 10px;\n  font-weight: 600;\n  border: 1px solid transparent;\n  transition: 0.16s ease;\n}\n.primary-button {\n  background: #b9e3ce;\n  color: #13221b;\n}\n.primary-button:hover {\n  background: #d1f1e1;\n  transform: translateY(-1px);\n}\n.secondary-button {\n  background: #27352f;\n  color: #cee2d8;\n  border-color: #3a5147;\n}\n.secondary-button:hover {\n  background: #30443b;\n}\n.primary-button span,\n.secondary-button span {\n  font-size: 13px;\n}\n.full-button {\n  width: 100%;\n  margin-top: 3px;\n}\n.field-note {\n  display: block;\n  margin-top: 10px;\n  font-size: 9px;\n  color: #778581;\n  line-height: 1.5;\n}\n.form-divider {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: #7d8986;\n  font-size: 9px;\n}\n.form-divider:before,\n.form-divider:after {\n  content: \"\";\n  height: 1px;\n  background: #30393a;\n  flex: 1;\n}\n.claims-panel {\n  margin-top: 15px;\n}\n.claim-form {\n  display: grid;\n  grid-template-columns: 1.1fr 0.9fr 1.6fr auto;\n  gap: 8px;\n  margin-bottom: 14px;\n}\n.claim-form button {\n  white-space: nowrap;\n}\n.claim-list {\n  border-top: 1px solid #293234;\n}\n.claim-row,\n.review-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 11px 3px;\n  border-bottom: 1px solid #293234;\n}\n.claim-row > div {\n  min-width: 0;\n  flex: 1;\n}\n.claim-row strong,\n.review-row strong {\n  display: block;\n  font-size: 10px;\n  font-weight: 500;\n  color: #d3dcda;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.claim-row small,\n.review-row small {\n  display: block;\n  margin-top: 4px;\n  color: #7e8b88;\n  font-size: 9px;\n}\n.claim-predicate {\n  color: #8bac9b;\n}\n.status-dot {\n  width: 7px;\n  height: 7px;\n  flex: 0 0 7px;\n  border-radius: 50%;\n  background: #70b08d;\n}\n.status-dot.proposed {\n  background: #d1ad68;\n}\n.status-dot.rejected {\n  background: #bd7773;\n}\n.link-button {\n  border: 0;\n  background: transparent;\n  color: #a8d9c0;\n  font-size: 10px;\n}\n.empty-hint {\n  font-size: 10px;\n  color: #7e8d89;\n  line-height: 1.7;\n  margin: 12px 0;\n}\n.review-list .panel {\n  min-height: 205px;\n}\n.review-row > div:first-child {\n  display: grid;\n  grid-template-columns: 8px 1fr;\n  align-items: center;\n  column-gap: 9px;\n  flex: 1;\n  min-width: 0;\n}\n.review-row small {\n  grid-column: 2;\n}\n.review-actions {\n  display: flex;\n  gap: 6px;\n}\n.review-actions button {\n  border: 1px solid var(--line);\n  background: #1b2224;\n  color: #a8b4b1;\n  border-radius: 6px;\n  padding: 6px 9px;\n  font-size: 9px;\n}\n.review-actions .accept-button {\n  background: #274036;\n  color: #bce1ce;\n  border-color: #385848;\n}\n.welcome-card {\n  margin: 10vh auto 0;\n  max-width: 760px;\n  padding: 50px 54px;\n  border: 1px solid #33413d;\n  border-radius: 20px;\n  background:\n    radial-gradient(ellipse at 93% -10%, #30443a66, transparent 45%),\n    linear-gradient(145deg, #1b2423, #161d1e);\n  box-shadow: 0 20px 80px #0002;\n}\n.welcome-card h1 {\n  font-size: 37px;\n  max-width: 550px;\n  margin-top: 14px;\n}\n.welcome-card p {\n  max-width: 510px;\n}\n.inline-create {\n  display: flex;\n  gap: 9px;\n  margin-top: 26px;\n  max-width: 530px;\n}\n.inline-create input {\n  font-size: 11px;\n  padding: 12px;\n}\n.inline-create button {\n  white-space: nowrap;\n}\n.welcome-points {\n  display: flex;\n  gap: 20px;\n  flex-wrap: wrap;\n  margin-top: 25px;\n  color: #8b9994;\n  font-size: 9px;\n}\n.welcome-points span::first-letter {\n  color: #9fd3b6;\n}\n.story-grid,\n.journal-grid,\n.scenario-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.45fr) minmax(270px, 0.8fr);\n  gap: 14px;\n}\n.story-canvas {\n  min-height: 440px;\n  position: relative;\n  overflow: hidden;\n  background: radial-gradient(\n    ellipse at 52% 45%,\n    #24332e 0%,\n    #1b2524 36%,\n    #161d1f 74%\n  );\n}\n.scene-topline {\n  display: flex;\n  justify-content: space-between;\n  color: #83918d;\n  font-size: 9px;\n}\n.scene-indicator {\n  border: 1px solid #3c584b;\n  color: #a4d1b6;\n  border-radius: 5px;\n  padding: 4px 7px;\n  letter-spacing: 0.1em;\n  font-size: 8px;\n}\n.story-placeholder {\n  max-width: 360px;\n  margin: 80px auto 40px;\n  text-align: center;\n}\n.story-sigil {\n  font-size: 31px;\n  color: #91bba4;\n}\n.story-placeholder h2 {\n  font:\n    600 20px/1.3 Manrope,\n    sans-serif;\n  margin: 13px 0 8px;\n  letter-spacing: -0.03em;\n}\n.story-placeholder p {\n  font-size: 11px;\n  color: #91a09b;\n  line-height: 1.75;\n  margin-bottom: 20px;\n}\n.context-panel {\n  align-self: start;\n}\n.privacy-tag {\n  font-size: 8px;\n  color: #a6d4b8;\n  letter-spacing: 0.1em;\n  border: 1px solid #3d5649;\n  border-radius: 20px;\n  padding: 5px 7px;\n}\n.field-label {\n  font-size: 10px;\n  margin: 13px 0;\n}\n.context-result {\n  border-top: 1px solid #2d3737;\n  margin-top: 16px;\n  padding-top: 13px;\n}\n.context-result-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.context-result-heading strong {\n  font: 600 10px Manrope;\n}\n.context-result-heading small {\n  font-size: 9px;\n  color: #80908b;\n}\n.context-claim {\n  display: grid;\n  gap: 4px;\n  padding: 10px 0;\n  border-bottom: 1px solid #293234;\n}\n.context-claim span {\n  color: #a6c5b3;\n  font-size: 9px;\n}\n.context-claim strong {\n  font-size: 10px;\n  font-weight: 500;\n}\n.context-claim small,\n.excluded-count {\n  font-size: 8px;\n  color: #798883;\n}\n.excluded-count {\n  display: block;\n  margin-top: 9px;\n}\n.inline-error {\n  font-size: 10px;\n  color: #e8a49e;\n}\n.journal-grid {\n  grid-template-columns: minmax(270px, 0.78fr) minmax(0, 1.3fr);\n  align-items: start;\n}\n.journal-empty {\n  text-align: center;\n  padding: 65px 40px;\n  min-height: 300px;\n}\n.journal-mark {\n  color: #91bba4;\n  font-size: 25px;\n}\n.journal-empty h2 {\n  font: 600 17px Manrope;\n  margin: 13px;\n}\n.journal-empty p {\n  max-width: 430px;\n  margin: 0 auto 19px;\n  color: #8e9b97;\n  font-size: 11px;\n  line-height: 1.8;\n}\n.status-pill {\n  display: inline-block;\n  border: 1px solid #4c4536;\n  color: #ceb783;\n  background: #27241e;\n  border-radius: 20px;\n  padding: 6px 9px;\n  letter-spacing: 0.06em;\n  font-size: 8px;\n}\n.scenario-banner {\n  display: flex;\n  align-items: center;\n  gap: 13px;\n  border: 1px solid #354338;\n  background: linear-gradient(110deg, #1b2823, #1b2223);\n  padding: 14px 16px;\n  border-radius: 12px;\n  margin-bottom: 14px;\n}\n.branch-symbol {\n  width: 34px;\n  height: 34px;\n  display: grid;\n  place-items: center;\n  color: #c6ac7b;\n  border-radius: 10px;\n  background: #393326;\n  font-size: 17px;\n}\n.scenario-banner > div:nth-child(2) {\n  flex: 1;\n}\n.scenario-banner strong {\n  font-size: 11px;\n}\n.scenario-banner p {\n  color: #8d9b96;\n  font-size: 10px;\n  margin: 4px 0 0;\n}\n.scenario-stats {\n  display: flex;\n  gap: 26px;\n  padding: 10px 0 14px;\n}\n.scenario-stats strong {\n  display: block;\n  font: 700 20px Manrope;\n}\n.scenario-stats small {\n  display: block;\n  color: #82908c;\n  font-size: 9px;\n  margin-top: 3px;\n}\n.branch-note {\n  border-top: 1px solid var(--line);\n  padding-top: 13px;\n  color: #9ab7a8;\n  font-size: 9px;\n  line-height: 1.6;\n}\n.scenario-grid .panel {\n  min-height: 210px;\n}\n\n@media (max-width: 1120px) {\n  .app-shell {\n    grid-template-columns: 220px 1fr;\n  }\n  .sidebar {\n    width: 220px;\n  }\n  .page-content {\n    padding-left: 26px;\n    padding-right: 26px;\n  }\n  .topbar {\n    padding: 0 26px;\n  }\n  .knowledge-grid {\n    grid-template-columns: minmax(0, 1.25fr) minmax(230px, 0.8fr);\n  }\n  .claim-form {\n    grid-template-columns: 1fr 1fr;\n  }\n  .claim-form input:nth-of-type(2) {\n    grid-column: 1/-1;\n  }\n}\n@media (max-width: 950px) {\n  .app-shell {\n    grid-template-columns: 68px 1fr;\n  }\n  .sidebar {\n    width: 68px;\n    padding: 18px 9px;\n  }\n  .brand {\n    padding: 0 8px 31px;\n  }\n  .brand > div:last-child,\n  .workspace-label,\n  .workspace-select,\n  .nav-item > span:last-child,\n  .sidebar-version,\n  .sidebar-bottom {\n    display: none;\n  }\n  .nav-item {\n    justify-content: center;\n    padding: 12px 7px;\n  }\n  .nav-icon {\n    font-size: 18px;\n  }\n  .primary-nav {\n    margin-top: 10px;\n  }\n  .sidebar-bottom {\n    display: block;\n    border: 0;\n    padding: 0;\n  }\n  .privacy-dot {\n    margin-left: 20px;\n  }\n  .main-area {\n    grid-column: 2;\n  }\n  .knowledge-grid {\n    grid-template-columns: 1fr;\n  }\n  .stacked-panels {\n    grid-template-columns: 1fr 1fr;\n  }\n  .metric-row {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n.journal-timeline {\n  margin-top: 14px;\n}\n.journal-memory-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.3fr) minmax(250px, 0.8fr);\n  gap: 16px;\n  align-items: start;\n}\n.journal-event-list {\n  display: grid;\n  gap: 10px;\n  align-content: start;\n}\n.journal-event-card {\n  border: 1px solid #2b3735;\n  background: linear-gradient(145deg, #1a2322, #151c1e);\n  border-radius: 11px;\n  padding: 14px;\n}\n.journal-event-topline {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n.journal-event-topline > small {\n  color: #788783;\n  font-size: 8px;\n}\n.journal-time-kind {\n  font-size: 8px;\n  letter-spacing: 0.09em;\n  color: #a6d4b8;\n}\n.journal-time-kind.range {\n  color: #d4bd8c;\n}\n.journal-time-kind.relative {\n  color: #9ec2d0;\n}\n.journal-time-kind.unknown {\n  color: #9ca6a3;\n}\n.journal-event-card h3 {\n  font:\n    600 13px Manrope,\n    sans-serif;\n  margin: 10px 0 5px;\n  color: #dfe8e4;\n}\n.journal-event-time {\n  font-size: 10px;\n  color: #b8d7c6;\n}\n.journal-event-details {\n  font-size: 10px;\n  line-height: 1.65;\n  color: #a4b0ac;\n  margin: 9px 0;\n}\n.journal-participants {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  flex-wrap: wrap;\n  margin-top: 10px;\n}\n.journal-participants > span {\n  font-size: 8px;\n  color: #798782;\n  margin-right: 3px;\n}\n.journal-participants small {\n  font-size: 8px;\n  color: #b5c8bf;\n  border: 1px solid #304139;\n  border-radius: 12px;\n  padding: 4px 7px;\n}\n.journal-event-source {\n  margin-top: 11px;\n  padding: 9px 10px;\n  border-left: 2px solid #638b75;\n  background: #19221f;\n}\n.journal-event-source strong {\n  font-size: 9px;\n  font-weight: 500;\n  color: #aac9b8;\n}\n.journal-event-source blockquote,\n.journal-history-version blockquote {\n  font-size: 9px;\n  line-height: 1.6;\n  color: #94a39d;\n  margin: 6px 0 0;\n}\n.journal-event-actions {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-top: 10px;\n  padding-top: 8px;\n  border-top: 1px solid #283231;\n}\n.journal-event-actions .link-button {\n  padding: 0;\n}\n.journal-event-history {\n  font-size: 9px;\n  color: #91a19a;\n}\n.journal-event-history summary {\n  cursor: pointer;\n}\n.journal-history-version {\n  margin-top: 8px;\n  padding: 9px;\n  border: 1px solid #2a3432;\n  border-radius: 7px;\n  background: #151b1c;\n}\n.journal-history-version strong,\n.journal-history-version small {\n  display: block;\n}\n.journal-history-version strong {\n  font-size: 9px;\n  font-weight: 500;\n  color: #bbc9c3;\n}\n.journal-history-version small {\n  margin-top: 4px;\n  font-size: 8px;\n  color: #7f8c87;\n}\n.journal-history-version p {\n  font-size: 9px;\n  line-height: 1.55;\n  color: #a4b0ac;\n  margin: 6px 0 0;\n}\n.journal-event-form {\n  border: 1px solid #2c3935;\n  background: #151c1d;\n  border-radius: 11px;\n  padding: 14px;\n}\n.journal-form-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 10px;\n  margin-bottom: 10px;\n}\n.journal-form-heading h3 {\n  font:\n    600 12px Manrope,\n    sans-serif;\n  margin: 0;\n}\n.journal-form-heading p {\n  font-size: 9px;\n  line-height: 1.55;\n  color: #83918c;\n  margin: 5px 0 0;\n}\n.journal-form-heading .link-button {\n  padding: 0;\n}\n.journal-event-form form {\n  display: grid;\n  gap: 2px;\n}\n.journal-event-form .field-label {\n  margin: 7px 0;\n}\n.journal-event-form input,\n.journal-event-form select,\n.journal-event-form textarea {\n  width: 100%;\n  border: 1px solid #303a3c;\n  background: #111719;\n  color: var(--text);\n  border-radius: 7px;\n  padding: 9px 10px;\n  outline: none;\n  font-size: 10px;\n}\n.journal-event-form input:focus,\n.journal-event-form select:focus,\n.journal-event-form textarea:focus {\n  border-color: #5d8b76;\n}\n.journal-event-form textarea {\n  resize: vertical;\n  line-height: 1.5;\n}\n.journal-date-range {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n}\n@media (max-width: 950px) {\n  .journal-grid,\n  .journal-memory-grid {\n    grid-template-columns: 1fr;\n  }\n}\n.journal-date-filter {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n  margin: 0 0 4px;\n  padding: 10px 11px;\n  border: 1px solid #283432;\n  border-radius: 9px;\n  background: #141a1b;\n  color: #8f9e98;\n  font-size: 9px;\n}\n.journal-date-filter > span {\n  margin-right: 3px;\n}\n.journal-date-filter label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: #a3b0aa;\n}\n.journal-date-filter input {\n  border: 1px solid #303a3c;\n  background: #111719;\n  color: var(--text);\n  border-radius: 6px;\n  padding: 6px 7px;\n  font-size: 9px;\n}\n.journal-date-filter .link-button {\n  margin-left: auto;\n}\n.journal-date-filter-note {\n  display: block;\n  margin: 4px 0 12px;\n  color: #778580;\n  font-size: 8px;\n}\n.scenario-rule-panel {\n  margin-top: 14px;\n}\n.scenario-rule-layout {\n  display: grid;\n  grid-template-columns: minmax(255px, 0.82fr) minmax(0, 1.35fr);\n  gap: 14px;\n  align-items: start;\n}\n.scenario-rule-form {\n  border: 1px solid #2b3735;\n  background: #151c1d;\n  border-radius: 11px;\n  padding: 14px;\n}\n.scenario-rule-form-heading h3 {\n  font:\n    600 12px Manrope,\n    sans-serif;\n  margin: 0;\n}\n.scenario-rule-form-heading p {\n  font-size: 9px;\n  color: #83918c;\n  margin: 5px 0 10px;\n}\n.scenario-rule-form form {\n  display: grid;\n  gap: 2px;\n}\n.scenario-rule-form .field-label {\n  margin: 7px 0;\n}\n.scenario-rule-form input,\n.scenario-rule-form select,\n.scenario-rule-form textarea {\n  width: 100%;\n  border: 1px solid #303a3c;\n  background: #111719;\n  color: var(--text);\n  border-radius: 7px;\n  padding: 9px 10px;\n  outline: none;\n  font-size: 10px;\n}\n.scenario-rule-form input:focus,\n.scenario-rule-form select:focus,\n.scenario-rule-form textarea:focus {\n  border-color: #5d8b76;\n}\n.scenario-rule-form textarea {\n  resize: vertical;\n  line-height: 1.5;\n}\n.scenario-rule-condition {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n}\n.scenario-rule-results {\n  display: grid;\n  gap: 9px;\n  align-content: start;\n}\n.scenario-rule-result {\n  border: 1px solid #2a3432;\n  border-left: 3px solid #65726d;\n  border-radius: 9px;\n  background: #151b1c;\n  padding: 12px;\n}\n.scenario-rule-result.satisfied {\n  border-left-color: #78b291;\n}\n.scenario-rule-result.violated {\n  border-left-color: #cf827b;\n}\n.scenario-rule-result.unknown {\n  border-left-color: #c5a76e;\n}\n.scenario-rule-result.proposed {\n  border-left-color: #c5a76e;\n}\n.scenario-rule-result.rejected {\n  opacity: 0.72;\n}\n.scenario-rule-result-top {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 10px;\n}\n.scenario-rule-result-top > div {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n}\n.scenario-rule-result h3 {\n  font:\n    600 11px Manrope,\n    sans-serif;\n  margin: 0;\n  color: #dce6e1;\n}\n.rule-severity,\n.rule-state {\n  font-size: 8px;\n  letter-spacing: 0.06em;\n  border: 1px solid #35413d;\n  border-radius: 12px;\n  padding: 4px 7px;\n  white-space: nowrap;\n}\n.rule-severity.hard {\n  color: #e3bb82;\n  border-color: #574833;\n}\n.rule-severity.soft {\n  color: #9cbdab;\n  border-color: #344a40;\n}\n.rule-state.satisfied {\n  color: #a8dbba;\n  border-color: #395848;\n}\n.rule-state.violated {\n  color: #e9a6a0;\n  border-color: #603b38;\n}\n.rule-state.unknown,\n.rule-state.proposed {\n  color: #dcc18a;\n  border-color: #594b31;\n}\n.rule-state.rejected {\n  color: #a3aaa6;\n}\n.scenario-rule-expression {\n  font-size: 9px;\n  line-height: 1.5;\n  color: #b7c7bf;\n  margin: 9px 0 0;\n}\n.scenario-rule-expression small {\n  display: block;\n  color: #74827d;\n  font-size: 8px;\n  margin-top: 3px;\n}\n.scenario-rule-description,\n.scenario-rule-explanation {\n  font-size: 9px;\n  line-height: 1.55;\n  color: #8d9c96;\n  margin: 7px 0 0;\n}\n.scenario-rule-evidence {\n  display: block;\n  font-size: 8px;\n  line-height: 1.5;\n  color: #a8c5b4;\n  margin-top: 7px;\n}\n.scenario-rule-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 7px;\n  margin-top: 10px;\n  padding-top: 8px;\n  border-top: 1px solid #2a3432;\n}\n.scenario-rule-actions button {\n  border: 1px solid var(--line);\n  background: #1b2224;\n  color: #a8b4b1;\n  border-radius: 6px;\n  padding: 6px 9px;\n  font-size: 9px;\n}\n.scenario-rule-actions .accept-button {\n  background: #274036;\n  color: #bce1ce;\n  border-color: #385848;\n}\n@media (max-width: 950px) {\n  .scenario-rule-layout {\n    grid-template-columns: 1fr;\n  }\n}\n\n.scenario-create-panel,\n.scenario-options-panel {\n  margin-top: 14px;\n}\n.scenario-create-form {\n  display: grid;\n  gap: 14px;\n}\n.scenario-create-basics {\n  display: grid;\n  grid-template-columns: minmax(180px, 0.75fr) minmax(260px, 1.4fr) minmax(\n      220px,\n      1fr\n    );\n  gap: 12px;\n}\n.scenario-create-options {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 10px;\n}\n.scenario-option-input {\n  display: grid;\n  gap: 8px;\n  border: 1px solid #2a3432;\n  background: #151b1c;\n  border-radius: 9px;\n  padding: 11px;\n}\n.scenario-option-input > span,\n.scenario-section-label {\n  font-size: 8px;\n  color: #85a797;\n  letter-spacing: 0.12em;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n.scenario-option-input input,\n.scenario-option-input textarea,\n.scenario-create-basics input,\n.scenario-create-basics textarea,\n.scenario-assumption-form input,\n.scenario-assumption-form select,\n.scenario-select-label select {\n  width: 100%;\n  border: 1px solid #303a3c;\n  background: #111719;\n  color: var(--text);\n  border-radius: 7px;\n  padding: 9px 10px;\n  outline: none;\n  font-size: 10px;\n}\n.scenario-option-input textarea,\n.scenario-create-basics textarea {\n  resize: vertical;\n  line-height: 1.5;\n}\n.scenario-evidence-pickers {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n.scenario-evidence-pickers details {\n  position: relative;\n}\n.scenario-evidence-pickers summary {\n  cursor: pointer;\n  border: 1px solid var(--line);\n  border-radius: 7px;\n  padding: 9px 11px;\n  color: #aab7b2;\n  font-size: 9px;\n  list-style: none;\n}\n.scenario-evidence-pickers summary::-webkit-details-marker {\n  display: none;\n}\n.scenario-evidence-list {\n  position: absolute;\n  z-index: 2;\n  top: 36px;\n  left: 0;\n  width: 290px;\n  max-height: 240px;\n  overflow: auto;\n  padding: 9px;\n  border: 1px solid #35413d;\n  border-radius: 8px;\n  background: #151b1d;\n  box-shadow: 0 12px 28px #0008;\n  display: grid;\n  gap: 7px;\n}\n.scenario-evidence-list label {\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n  color: #bfcbc6;\n  font-size: 9px;\n}\n.scenario-evidence-list input {\n  margin: 2px 0 0;\n  accent-color: #82b89b;\n}\n.scenario-evidence-list span {\n  display: grid;\n  gap: 3px;\n}\n.scenario-evidence-list small {\n  color: #7f8c87;\n  font-size: 8px;\n}\n.scenario-evidence-list > small {\n  color: #87938f;\n  font-size: 9px;\n}\n.scenario-evidence-pickers > .primary-button {\n  margin-left: auto;\n}\n.scenario-select-label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: #81908b;\n  font-size: 9px;\n}\n.scenario-select-label select {\n  width: 210px;\n}\n.scenario-brief {\n  display: grid;\n  grid-template-columns: minmax(240px, 1.15fr) minmax(210px, 0.8fr) minmax(\n      230px,\n      1fr\n    );\n  gap: 15px;\n  border: 1px solid #293432;\n  background: #151b1c;\n  border-radius: 10px;\n  padding: 14px;\n  margin: 2px 0 14px;\n}\n.scenario-brief p {\n  font-size: 10px;\n  line-height: 1.65;\n  color: #c0ccc7;\n  margin: 7px 0 0;\n  white-space: pre-wrap;\n}\n.scenario-brief ul {\n  margin: 7px 0 0;\n  padding-left: 17px;\n  color: #aab7b1;\n  font-size: 9px;\n  line-height: 1.7;\n}\n.scenario-brief .empty-hint {\n  margin-top: 7px;\n}\n.scenario-evidence-summary {\n  display: grid;\n  gap: 6px;\n  margin-top: 7px;\n}\n.scenario-evidence-summary span,\n.scenario-evidence-summary small {\n  font-size: 8px;\n  line-height: 1.5;\n  color: #a9c3b5;\n  border-left: 2px solid #456452;\n  padding-left: 7px;\n}\n.scenario-evidence-summary small {\n  color: #82908a;\n  border-color: #46514d;\n}\n.scenario-option-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));\n  gap: 12px;\n}\n.scenario-option-card {\n  min-width: 0;\n  border: 1px solid #2a3432;\n  background: linear-gradient(155deg, #192122, #141a1b);\n  border-radius: 11px;\n  padding: 13px;\n}\n.scenario-option-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n.scenario-option-heading h3 {\n  font:\n    600 14px Manrope,\n    sans-serif;\n  margin: 4px 0 0;\n  color: #e0e8e4;\n}\n.scenario-option-summary {\n  font-size: 8px;\n  color: #a7b7ae;\n  border: 1px solid #34443a;\n  border-radius: 14px;\n  padding: 5px 7px;\n  text-align: center;\n}\n.scenario-option-description {\n  font-size: 9px;\n  line-height: 1.55;\n  color: #8e9c96;\n  margin: 8px 0;\n}\n.scenario-option-assumptions,\n.scenario-option-outcomes {\n  border-top: 1px solid #293432;\n  margin-top: 12px;\n  padding-top: 10px;\n}\n.scenario-subheading {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 8px;\n}\n.scenario-subheading h4 {\n  font:\n    600 10px Manrope,\n    sans-serif;\n  margin: 0;\n  color: #c3d0ca;\n}\n.scenario-subheading > span {\n  font-size: 8px;\n  color: #87958f;\n}\n.scenario-assumption {\n  border: 1px solid #303a36;\n  border-radius: 8px;\n  background: #151b1b;\n  padding: 9px;\n  margin: 7px 0;\n}\n.scenario-assumption.proposed {\n  border-color: #4b422f;\n}\n.scenario-assumption.rejected {\n  opacity: 0.7;\n}\n.scenario-assumption-heading {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  align-items: flex-start;\n}\n.scenario-assumption-heading strong {\n  font-size: 9px;\n  color: #c8d3ce;\n  line-height: 1.5;\n}\n.scenario-assumption-heading span {\n  font-size: 8px;\n  color: #9eaa9f;\n  white-space: nowrap;\n}\n.scenario-assumption > small {\n  display: block;\n  color: #77857f;\n  font-size: 8px;\n  margin-top: 5px;\n}\n.scenario-assumption-form {\n  display: grid;\n  gap: 4px;\n  border: 1px dashed #33403a;\n  border-radius: 8px;\n  padding: 9px;\n  margin-top: 8px;\n}\n.scenario-assumption-form .field-label {\n  font-size: 8px;\n  margin: 4px 0;\n}\n.scenario-assumption-fields {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n}\n.scenario-assumption-save {\n  justify-self: end;\n  border: 1px solid #395247 !important;\n  border-radius: 6px;\n  color: #b5d6c4 !important;\n  background: #1b2c25 !important;\n  font-size: 9px !important;\n  padding: 6px 9px !important;\n}\n.scenario-edit-trigger {\n  font-size: 8px !important;\n  padding: 3px 0 !important;\n}\n.scenario-editing-note {\n  display: flex;\n  justify-content: space-between;\n  color: #d7be89;\n  font-size: 8px;\n}\n.scenario-editing-note button {\n  border: 0;\n  background: none;\n  color: #9fb0a8;\n  font-size: 8px;\n}\n.scenario-assumption-history {\n  margin-top: 8px;\n  color: #899790;\n  font-size: 8px;\n}\n.scenario-assumption-history summary {\n  cursor: pointer;\n}\n.scenario-assumption-history p {\n  margin: 5px 0 0 10px;\n  color: #798680;\n}\n.scenario-outcome {\n  border-left: 2px solid #66736d;\n  border-radius: 5px;\n  background: #141a1b;\n  padding: 8px 9px;\n  margin: 7px 0;\n}\n.scenario-outcome.satisfied {\n  border-left-color: #78b291;\n}\n.scenario-outcome.violated {\n  border-left-color: #cf827b;\n}\n.scenario-outcome.unknown {\n  border-left-color: #c5a76e;\n}\n.scenario-outcome-heading {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  flex-wrap: wrap;\n}\n.scenario-outcome-heading strong {\n  font-size: 9px;\n  color: #cbd5d0;\n}\n.scenario-outcome-heading small {\n  font-size: 7px;\n  color: #d5bb81;\n  border: 1px solid #52452f;\n  border-radius: 10px;\n  padding: 3px 6px;\n  text-transform: uppercase;\n  letter-spacing: 0.07em;\n}\n.scenario-outcome p {\n  font-size: 8px;\n  line-height: 1.5;\n  color: #8e9c96;\n  margin: 6px 0 0;\n}\n.scenario-outcome > small {\n  display: block;\n  font-size: 8px;\n  line-height: 1.4;\n  color: #9ebbaa;\n  margin-top: 5px;\n}\n@media (max-width: 1100px) {\n  .scenario-create-basics,\n  .scenario-brief {\n    grid-template-columns: 1fr 1fr;\n  }\n  .scenario-create-basics .field-label:nth-child(3) {\n    grid-column: 1/-1;\n  }\n}\n@media (max-width: 950px) {\n  .scenario-create-options {\n    grid-template-columns: 1fr;\n  }\n  .scenario-brief {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* Narrow desktop windows collapse the side rail into a compact top navigation. */\n@media (max-width: 720px) {\n  body {\n    min-width: 320px;\n  }\n  .app-shell {\n    display: block;\n    min-width: 0;\n  }\n  .sidebar {\n    position: sticky;\n    inset: auto;\n    top: 0;\n    width: 100%;\n    height: auto;\n    min-height: 0;\n    flex-direction: row;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 8px;\n    padding: 9px 12px;\n    border-right: 0;\n    border-bottom: 1px solid var(--line);\n  }\n  .brand {\n    flex: 0 0 auto;\n    margin-right: auto;\n    padding: 0 4px;\n  }\n  .brand > div:last-child {\n    display: block;\n  }\n  .brand span {\n    font-size: 8px;\n  }\n  .workspace-label {\n    display: none;\n  }\n  .workspace-select {\n    display: block;\n    flex: 0 1 190px;\n    width: auto;\n    min-width: 120px;\n    height: 36px;\n    margin: 0;\n    font-size: 11px;\n  }\n  .primary-nav {\n    display: flex;\n    flex: 1 0 100%;\n    gap: 4px;\n    width: 100%;\n    min-width: 0;\n    margin: 0;\n    overflow-x: auto;\n    padding-bottom: 2px;\n  }\n  .nav-item {\n    flex: 1 0 auto;\n    justify-content: flex-start;\n    align-items: center;\n    min-width: 78px;\n    padding: 8px 9px;\n  }\n  .nav-item > span:last-child {\n    display: block;\n    min-width: 0;\n  }\n  .nav-item > span:last-child small {\n    display: none;\n  }\n  .nav-item b {\n    font-size: 11px;\n    white-space: nowrap;\n  }\n  .nav-icon {\n    flex: none;\n  }\n  .sidebar-bottom {\n    display: none;\n  }\n  .main-area {\n    grid-column: 1;\n    min-width: 0;\n  }\n  .topbar {\n    height: auto;\n    min-height: 52px;\n    flex-wrap: wrap;\n    gap: 8px;\n    padding: 9px 14px;\n  }\n  .breadcrumbs {\n    min-width: 0;\n    max-width: 100%;\n    overflow: hidden;\n  }\n  .top-actions {\n    flex-wrap: wrap;\n    gap: 5px 8px;\n    max-width: 100%;\n  }\n  .page-content {\n    min-width: 0;\n    padding: 18px 14px 48px;\n  }\n  .page-heading {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 12px;\n  }\n  .metric-row {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .stacked-panels {\n    grid-template-columns: 1fr;\n  }\n}\n@media (max-width: 480px) {\n  .sidebar {\n    padding: 8px;\n  }\n  .brand {\n    gap: 7px;\n    padding: 0;\n  }\n  .workspace-select {\n    flex-basis: 150px;\n    max-width: 48vw;\n    min-width: 100px;\n    padding: 0 7px;\n  }\n  .primary-nav {\n    gap: 2px;\n  }\n  .nav-item {\n    min-width: 72px;\n    gap: 6px;\n    padding: 8px 6px;\n  }\n  .nav-item b {\n    font-size: 10px;\n  }\n  .nav-icon {\n    width: 16px;\n    font-size: 14px;\n  }\n  .topbar {\n    padding: 8px 10px;\n  }\n  .top-actions {\n    gap: 3px 5px;\n  }\n  .top-actions .quiet-button {\n    padding: 6px;\n    font-size: 10px;\n  }\n  .page-content {\n    padding-right: 10px;\n    padding-left: 10px;\n  }\n  .metric-row {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n.temporal-query-form {\n  display: grid;\n  gap: 8px;\n  margin-top: 18px;\n  padding-top: 4px;\n}\n.temporal-query-form textarea {\n  width: 100%;\n  border: 1px solid #303a3c;\n  background: #111719;\n  color: var(--text);\n  border-radius: 7px;\n  padding: 9px 10px;\n  outline: none;\n  font-size: 10px;\n  line-height: 1.6;\n  resize: vertical;\n}\n.temporal-query-form textarea:focus {\n  border-color: #5d8b76;\n}\n.temporal-query-form textarea:disabled {\n  opacity: 0.7;\n}\n.temporal-answer {\n  margin-top: 13px;\n  padding: 12px;\n  border: 1px solid #35483e;\n  border-radius: 9px;\n  background: #17211d;\n}\n.temporal-answer.insufficient {\n  border-color: #4a4334;\n  background: #211f1a;\n}\n.temporal-answer > p {\n  font-size: 11px;\n  line-height: 1.7;\n  color: #d3dfd9;\n  white-space: pre-wrap;\n}\n.temporal-citation {\n  display: grid;\n  gap: 4px;\n  padding: 9px 0;\n  border-top: 1px solid #2b3933;\n}\n.temporal-citation strong {\n  font-size: 10px;\n  font-weight: 500;\n  color: #a9cfb8;\n}\n.temporal-citation small {\n  font-size: 8px;\n  color: #84938d;\n}\n.adventure-export-controls {\n  display: grid;\n  gap: 6px;\n  max-width: 760px;\n}\n.export-selection {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px 14px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 12px;\n}\n.export-selection legend {\n  padding: 0 6px;\n  color: #9aa8a4;\n  font-size: 9px;\n}\n.export-selection label {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  color: #c2ceca;\n  font-size: 10px;\n}\n.export-selection input {\n  accent-color: #8dc4a7;\n}\n.export-selection small {\n  margin-left: 3px;\n  color: #778581;\n}\n.export-preview {\n  display: grid;\n  gap: 6px;\n  padding: 12px;\n  border: 1px solid #35483e;\n  border-radius: 9px;\n  background: #17211d;\n  color: #aebdb6;\n  font-size: 9px;\n  line-height: 1.55;\n  overflow-wrap: anywhere;\n}\n.export-preview strong {\n  color: #d2e5da;\n  font-size: 10px;\n}\n.export-preview small {\n  color: #d8bf8b;\n}\n.world-architect-controls {\n  display: flex;\n  align-items: end;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n.world-architect-controls .field-label {\n  flex: 1;\n  min-width: 180px;\n  margin: 0;\n}\n.world-architect-controls button {\n  align-self: end;\n}\n.world-architect-preview p {\n  margin: 0;\n}\n.world-architect-preview button {\n  justify-self: start;\n}\n.story-visual-profile {\n  display: grid;\n  gap: 12px;\n  margin: 4px 0 18px;\n  padding: 16px;\n  border: 1px solid #34443d;\n  border-radius: 12px;\n  background: linear-gradient(145deg, #17201d, #151b1c);\n}\n.story-visual-profile-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 12px;\n}\n.story-visual-profile-heading h3 {\n  margin: 0;\n  color: #e0e9e4;\n  font-size: 16px;\n  font-weight: 600;\n}\n.story-visual-profile-heading p {\n  margin: 5px 0 0;\n  color: #9baaa3;\n  font-size: 13px;\n  line-height: 1.5;\n}\n.story-visual-profile > .field-note {\n  margin: 0;\n  font-size: 13px;\n  line-height: 1.55;\n}\n.story-visual-profile-form {\n  display: grid;\n  gap: 12px;\n}\n.story-visual-profile-form .field-label {\n  display: grid;\n  gap: 6px;\n  margin: 0;\n  color: #c8d4ce;\n  font-size: 14px;\n}\n.story-visual-profile-form textarea {\n  width: 100%;\n  min-height: 44px;\n  padding: 10px 12px;\n  border: 1px solid #3a4842;\n  border-radius: 8px;\n  background: #101617;\n  color: var(--text);\n  font: inherit;\n  font-size: 14px;\n  line-height: 1.55;\n  resize: vertical;\n}\n.story-visual-profile-form textarea:focus-visible,\n.story-visual-reference-list input:focus-visible,\n.story-visual-profile button:focus-visible {\n  outline: 2px solid #9bd2b2;\n  outline-offset: 2px;\n}\n.story-visual-profile-form textarea::placeholder {\n  color: #77857f;\n}\n.story-visual-reference-list {\n  display: grid;\n  gap: 8px;\n  margin: 0;\n  padding: 12px;\n  border: 1px solid #34413b;\n  border-radius: 9px;\n  min-width: 0;\n}\n.story-visual-reference-list legend {\n  padding: 0 5px;\n  color: #c8d4ce;\n  font-size: 14px;\n}\n.story-visual-reference-list > label {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 44px;\n  padding: 7px 9px;\n  border: 1px solid #2e3a35;\n  border-radius: 8px;\n  background: #131a19;\n  color: #d3ddd8;\n  font-size: 14px;\n  cursor: pointer;\n}\n.story-visual-reference-list input {\n  width: 18px;\n  height: 18px;\n  flex: 0 0 auto;\n  accent-color: #8dc4a7;\n}\n.story-visual-reference-list label span {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n.story-visual-reference-list label small,\n.story-visual-reference-list > .field-note {\n  color: #8c9b94;\n  font-size: 12px;\n  line-height: 1.45;\n}\n.story-visual-reference-list > .empty-hint {\n  margin: 0;\n  font-size: 13px;\n}\n.story-visual-profile-form .secondary-button {\n  min-height: 44px;\n  font-size: 14px;\n}\n.story-visual-profile-history {\n  display: grid;\n  gap: 9px;\n  padding-top: 10px;\n  border-top: 1px solid #2d3934;\n}\n.story-visual-profile-history .link-button {\n  justify-self: start;\n  min-height: 36px;\n  font-size: 13px;\n}\n.story-visual-profile-history ol {\n  display: grid;\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n.story-visual-profile-history li {\n  display: grid;\n  gap: 5px;\n  padding: 11px;\n  border: 1px solid #2e3b35;\n  border-radius: 8px;\n  background: #121918;\n}\n.story-visual-profile-history li strong {\n  color: #cce3d5;\n  font-size: 14px;\n}\n.story-visual-profile-history li small {\n  color: #88978f;\n  font-size: 12px;\n}\n.story-visual-profile-history li p {\n  margin: 0;\n  color: #c1cdc6;\n  font-size: 14px;\n  line-height: 1.6;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.story-image-workspace {\n  display: grid;\n  gap: 16px;\n  min-inline-size: 0;\n  margin-block: 16px 24px;\n  padding: 16px;\n  border: 1px solid #34443d;\n  border-radius: 12px;\n  background: linear-gradient(145deg, #17201d, #151b1c);\n}\n.story-image-workspace-heading,\n.story-image-job-heading,\n.story-image-subheading {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 12px;\n  min-inline-size: 0;\n}\n.story-image-workspace-heading h3,\n.story-image-subheading h4 {\n  margin: 0;\n  color: #e0e9e4;\n}\n.story-image-workspace-heading p,\n.story-image-job p {\n  margin-block: 6px 0;\n  color: #9baaa3;\n  line-height: 1.5;\n}\n.story-image-provider-status {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 12px;\n  border: 1px solid #3a4842;\n  border-radius: 10px;\n  background: #101617;\n  color: #d1ddd6;\n}\n.story-image-provider-status p {\n  margin: 4px 0 0;\n  color: #9baaa3;\n}\n.story-image-provider-dot {\n  flex: 0 0 10px;\n  inline-size: 10px;\n  block-size: 10px;\n  margin-block-start: 5px;\n  border-radius: 50%;\n  background: #c87362;\n}\n.story-image-provider-status.ready .story-image-provider-dot {\n  background: #78c99b;\n}\n.story-image-create-form {\n  display: grid;\n  gap: 14px;\n  min-inline-size: 0;\n}\n.story-image-create-form .field-label {\n  display: grid;\n  gap: 6px;\n  margin: 0;\n  color: #c8d4ce;\n  font-size: 14px;\n}\n.story-image-create-form textarea,\n.story-image-create-form input,\n.story-image-create-form select {\n  box-sizing: border-box;\n  inline-size: 100%;\n  min-inline-size: 0;\n}\n.story-image-create-form textarea {\n  resize: vertical;\n  line-height: 1.55;\n}\n.story-image-create-form textarea:focus-visible,\n.story-image-create-form input:focus-visible,\n.story-image-create-form select:focus-visible,\n.story-image-workspace button:focus-visible,\n.story-image-prompt-preview summary:focus-visible,\n.story-image-advanced summary:focus-visible {\n  outline: 3px solid #9bd2b2;\n  outline-offset: 2px;\n}\n.story-image-profile-note,\n.story-image-model-note {\n  margin: -6px 0 0;\n}\n.story-image-prompt-preview,\n.story-image-advanced {\n  min-inline-size: 0;\n  padding: 12px;\n  border: 1px solid #3a4842;\n  border-radius: 10px;\n  background: #101617;\n  color: #c8d4ce;\n}\n.story-image-prompt-preview summary,\n.story-image-advanced summary {\n  cursor: pointer;\n  font-weight: 650;\n}\n.story-image-prompt-preview p {\n  margin-block: 12px 0;\n  overflow-wrap: anywhere;\n  color: #c1cdc6;\n  line-height: 1.55;\n}\n.story-image-settings-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n  margin-block-start: 14px;\n}\n.story-image-negative-prompt {\n  grid-column: 1 / -1;\n}\n.story-image-advanced > .field-note {\n  margin-block-end: 0;\n}\n.story-image-history,\n.story-image-results {\n  display: grid;\n  gap: 10px;\n  min-inline-size: 0;\n  padding-block-start: 14px;\n  border-block-start: 1px solid #34443d;\n}\n.story-image-subheading {\n  align-items: baseline;\n}\n.story-image-subheading > span,\n.story-image-job > small,\n.story-image-frame-list small,\n.story-image-candidate small {\n  color: #9baaa3;\n  font-size: 0.875rem;\n}\n.story-image-job-list,\n.story-image-candidate-list,\n.story-image-frame-list {\n  display: grid;\n  gap: 10px;\n  min-inline-size: 0;\n  margin: 0;\n  padding-inline-start: 20px;\n}\n.story-image-job,\n.story-image-candidate {\n  min-inline-size: 0;\n  padding: 12px;\n  border: 1px solid #34443d;\n  border-radius: 10px;\n  background: #121918;\n}\n.story-image-job-heading {\n  align-items: center;\n  margin-block-end: 4px;\n  color: #dce7e0;\n}\n.story-image-status {\n  padding: 3px 8px;\n  border-radius: 999px;\n  background: #29312e;\n  color: #c3d0c9;\n  font-size: 0.8rem;\n  text-transform: capitalize;\n}\n.story-image-status.status-succeeded {\n  color: #b9e6c9;\n  background: #20392b;\n}\n.story-image-status.status-failed,\n.story-image-status.status-interrupted {\n  color: #ffc4b5;\n  background: #432722;\n}\n.story-image-frame-list {\n  gap: 8px;\n  margin-block: 10px;\n  padding-inline-start: 18px;\n  color: #c8d4ce;\n}\n.story-image-frame-list li,\n.story-image-candidate > div:first-child {\n  display: grid;\n  gap: 4px;\n  min-inline-size: 0;\n}\n.story-image-frame-error {\n  color: #ffc4b5 !important;\n}\n.story-image-candidate-list {\n  list-style: none;\n  padding-inline-start: 0;\n}\n.story-image-candidate {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: start;\n  gap: 12px;\n  color: #dce7e0;\n}\n.story-image-candidate-actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 8px;\n}\n.story-image-candidate-actions button,\n.story-image-job > button {\n  min-block-size: 40px;\n}\n.story-image-candidate-preview {\n  grid-column: 1 / -1;\n  display: block;\n  inline-size: auto;\n  max-inline-size: 100%;\n  max-block-size: 440px;\n  margin-inline: auto;\n  object-fit: contain;\n  border: 1px solid #34443d;\n  border-radius: 8px;\n  background: #1e2229;\n}\n.story-image-notice {\n  margin: 0;\n  padding: 10px 12px;\n  border-inline-start: 3px solid #78c99b;\n  background: #1d3024;\n  color: #d1e7d8;\n}\n\n@media (max-width: 520px) {\n  .story-visual-profile {\n    padding: 12px;\n  }\n  .story-visual-profile-heading {\n    display: grid;\n  }\n  .story-visual-profile-heading .status-pill {\n    justify-self: start;\n  }\n  .story-image-workspace {\n    padding: 12px;\n  }\n  .story-image-workspace-heading {\n    flex-direction: column;\n  }\n  .story-image-candidate {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .story-image-candidate-actions {\n    justify-content: flex-start;\n  }\n  .story-image-settings-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .story-image-negative-prompt {\n    grid-column: auto;\n  }\n}\n"],["STYLE",{},".belief-form {\n  margin-top: 18px;\n  padding-top: 12px;\n  border-top: 1px solid var(--line);\n}\n\n.branch-select {\n  max-width: 230px;\n  height: 28px;\n  padding: 0 24px 0 9px;\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  background: #171e20;\n  color: #aab7b4;\n  font-size: 10px;\n}\n\n.belief-form .form-divider {\n  margin: 6px 0 10px;\n}\n\n.belief-form .field-label {\n  margin: 10px 0;\n}\n\