n\n.relation-matrix thead th {\n  position: sticky;\n  top: 0;\n  z-index: 2;\n  background: #20292a;\n  color: #aab8b3;\n  font-weight: 600;\n}\n\n.relation-matrix tbody th {\n  position: sticky;\n  left: 0;\n  z-index: 1;\n  background: #1b2324;\n  color: #c6d3cd;\n  font-weight: 600;\n}\n\n.relation-matrix thead th:first-child {\n  left: 0;\n  z-index: 3;\n}\n\n.relation-matrix td.has-links {\n  background: #1b2523;\n}\n\n.matrix-link {\n  display: grid;\n  gap: 4px;\n  margin-bottom: 6px;\n  border-left: 2px solid #83b79e;\n  padding: 2px 0 2px 7px;\n  color: #c1ded0;\n  overflow-wrap: anywhere;\n}\n\n.matrix-link.proposed {\n  border-color: #d0ad69;\n  color: #ddc68f;\n}\n\n.matrix-link small,\n.matrix-empty {\n  color: #7e8c87;\n  font-size: 8px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.history-panel {\n  max-height: 720px;\n  overflow: auto;\n}\n\n.revision-list {\n  position: relative;\n  display: grid;\n  gap: 0;\n  margin: 6px 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.revision-list::before {\n  position: absolute;\n  top: 7px;\n  bottom: 18px;\n  left: 6px;\n  width: 1px;\n  background: #34413d;\n  content: \"\";\n}\n\n.revision-row {\n  position: relative;\n  display: flex;\n  gap: 13px;\n  padding: 10px 0;\n}\n\n.revision-marker {\n  position: relative;\n  z-index: 1;\n  flex: 0 0 13px;\n  width: 13px;\n  height: 13px;\n  border: 3px solid #5e957c;\n  border-radius: 50%;\n  background: #17201e;\n}\n\n.revision-copy {\n  flex: 1;\n  min-width: 0;\n}\n\n.revision-heading {\n  display: flex;\n  justify-content: space-between;\n  gap: 14px;\n  align-items: baseline;\n}\n\n.revision-heading strong {\n  color: #d1dbd6;\n  font-size: 10px;\n  font-weight: 600;\n}\n\n.revision-heading span {\n  flex: 0 0 auto;\n  color: #a5cfb7;\n  font-size: 9px;\n}\n\n.revision-copy small {\n  display: block;\n  margin-top: 5px;\n  color: #7e8c87;\n  font-size: 8px;\n}\n\n.context-export-button {\n  width: 100%;\n  margin-top: 11px;\n}\n\n.context-export-note,\n.context-export-success {\n  display: block;\n  margin: 7px 0 0;\n  color: #81908a;\n  font-size: 8px;\n  line-height: 1.6;\n}\n\n.context-export-success {\n  color: #a9d6bc;\n}\n\n.branch-differences {\n  display: grid;\n  gap: 9px;\n  max-height: 360px;\n  overflow: auto;\n}\n\n.branch-stale-note {\n  margin: 0 0 10px;\n  border: 1px solid #4b4432;\n  border-radius: 7px;\n  padding: 8px 9px;\n  background: #24231e;\n  color: #d1bb83;\n  font-size: 9px;\n  line-height: 1.6;\n}\n\n.branch-difference {\n  display: grid;\n  gap: 4px;\n  border: 1px solid #2d3b36;\n  border-radius: 8px;\n  padding: 9px 10px;\n  background: #19211f;\n}\n\n.branch-difference > span {\n  color: #9ac8ad;\n  font-size: 8px;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n.branch-difference strong {\n  color: #d2ddd7;\n  font-size: 10px;\n  font-weight: 500;\n  overflow-wrap: anywhere;\n}\n\n.branch-difference small {\n  color: #87968f;\n  font-size: 8px;\n}\n\n.branch-difference details,\n.branch-review-list details {\n  min-width: 0;\n  margin-top: 4px;\n}\n\n.branch-difference summary,\n.branch-review-list summary {\n  color: #aac5b8;\n  cursor: pointer;\n  font-size: 9px;\n}\n\n.branch-difference pre,\n.branch-review-list pre {\n  max-height: 300px;\n  margin: 8px 0 0;\n  overflow: auto;\n  border: 1px solid #293a34;\n  border-radius: 7px;\n  padding: 10px;\n  background: #111917;\n  color: #b8c8c0;\n  font:\n    9px/1.6 ui-monospace,\n    SFMono-Regular,\n    Consolas,\n    monospace;\n  overflow-wrap: anywhere;\n  white-space: pre-wrap;\n}\n\n.branch-review-panel {\n  margin-top: 16px;\n}\n\n.branch-review-actions {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.branch-review-list {\n  display: grid;\n  gap: 8px;\n  max-height: 440px;\n  margin: 12px 0 0;\n  overflow: auto;\n  padding: 0;\n  list-style: none;\n}\n\n.branch-review-list li {\n  border: 1px solid #2d3b36;\n  border-radius: 8px;\n  padding: 10px 12px;\n  background: #19211f;\n}\n\n.branch-review-list summary {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  gap: 5px 10px;\n  align-items: baseline;\n}\n\n.branch-review-list summary span {\n  color: #9ac8ad;\n  font-size: 9px;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n.branch-review-list summary strong {\n  color: #d2ddd7;\n  font-size: 10px;\n  font-weight: 500;\n}\n\n.branch-review-list summary small {\n  grid-column: 2;\n  color: #87968f;\n  font-size: 8px;\n}\n\n.branch-review-check {\n  display: flex;\n  gap: 8px;\n  align-items: flex-start;\n  margin-top: 14px;\n  color: #b8c8c0;\n  font-size: 10px;\n  line-height: 1.5;\n}\n\n.branch-review-check input {\n  margin-top: 1px;\n  accent-color: #86b79c;\n}\n\n.journal-notes {\n  min-width: 0;\n}\n\n.journal-entry-list {\n  display: grid;\n  gap: 6px;\n  max-height: 250px;\n  margin: 8px 0 14px;\n  overflow: auto;\n}\n\n.journal-entry {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  width: 100%;\n  min-width: 0;\n  border: 1px solid #2b3935;\n  border-radius: 8px;\n  padding: 9px 10px;\n  background: #18211f;\n  color: inherit;\n  text-align: left;\n}\n\n.journal-entry:hover,\n.journal-entry.selected {\n  border-color: #5c9278;\n  background: #1c2924;\n}\n\n.journal-entry-type {\n  display: grid;\n  flex: 0 0 30px;\n  width: 30px;\n  height: 30px;\n  place-items: center;\n  border: 1px solid #3c5448;\n  border-radius: 7px;\n  color: #a6d4b8;\n  font-size: 8px;\n  font-weight: 700;\n}\n\n.journal-entry-copy {\n  display: grid;\n  flex: 1;\n  min-width: 0;\n  gap: 4px;\n}\n\n.journal-entry-copy strong {\n  overflow: hidden;\n  color: #d4dfd9;\n  font-size: 10px;\n  font-weight: 600;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.journal-entry-copy small,\n.journal-reader-heading small {\n  color: #82918b;\n  font-size: 8px;\n}\n\n.journal-entry-arrow {\n  color: #8fbc9f;\n  font-size: 11px;\n}\n\n.journal-reader {\n  border-top: 1px solid #2d3936;\n  padding-top: 13px;\n}\n\n.journal-reader-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n}\n\n.journal-reader-heading h3 {\n  margin: 0 0 5px;\n  color: #e0e8e4;\n  font-size: 12px;\n  font-weight: 600;\n  overflow-wrap: anywhere;\n}\n\n.journal-reader pre {\n  max-height: 340px;\n  overflow: auto;\n  margin: 12px 0 0;\n  border: 1px solid #2b3734;\n  border-radius: 8px;\n  padding: 12px;\n  background: #121819;\n  color: #c4d0ca;\n  font:\n    10px/1.75 \"DM Sans\",\n    \"Segoe UI\",\n    sans-serif;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.journal-expand {\n  width: 100%;\n  margin-top: 8px;\n}\n\n.knowledge-toolbar {\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.knowledge-tabs {\n  flex-wrap: wrap;\n}\n\n.knowledge-toolbar .search-box {\n  margin-left: auto;\n}\n\n.extraction-workspace {\n  display: grid;\n  gap: 14px;\n}\n\n.extraction-control-row {\n  display: grid;\n  grid-template-columns: minmax(180px, 1fr) minmax(180px, 1fr) auto;\n  align-items: end;\n  gap: 10px;\n}\n\n.extraction-control-row .field-label,\n.extraction-review-fields .field-label {\n  display: grid;\n  gap: 6px;\n  margin: 0;\n  color: #aab6b2;\n  font-size: 9px;\n}\n\n.extraction-control-row select,\n.extraction-review-fields select {\n  min-width: 0;\n  height: 36px;\n  padding: 0 9px;\n  color: #e0e8e5;\n  background: #1a2224;\n  border: 1px solid #303a3b;\n  border-radius: 7px;\n  font-size: 10px;\n}\n\n.extraction-run {\n  min-height: 36px;\n  white-space: nowrap;\n}\n\n.extraction-batch {\n  border-top: 1px solid #293234;\n  padding-top: 12px;\n  margin-top: 12px;\n}\n\n.extraction-batch-heading,\n.extraction-candidate-title,\n.extraction-candidate-title > div {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n\n.extraction-batch-heading strong {\n  display: block;\n  color: #dce5e1;\n  font-size: 10px;\n}\n\n.extraction-batch-heading small,\n.extraction-batch-heading > span,\n.extraction-candidate-meta,\n.extraction-canonical {\n  display: block;\n  margin-top: 4px;\n  color: #82908c;\n  font-size: 9px;\n}\n\n.extraction-candidate {\n  margin-top: 10px;\n  padding: 12px;\n  border: 1px solid #2a3435;\n  border-radius: 9px;\n  background: #151b1d;\n}\n\n.extraction-candidate-title > div {\n  justify-content: flex-start;\n  min-width: 0;\n}\n\n.extraction-candidate-title strong {\n  min-width: 0;\n  color: #d5dfdb;\n  font-size: 10px;\n  font-weight: 550;\n  overflow-wrap: anywhere;\n}\n\n.extraction-status {\n  flex: 0 0 auto;\n  color: #d8bd7f;\n  font-size: 8px;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n.extraction-status.accepted,\n.extraction-canonical {\n  color: #a5d6ba;\n}\n\n.extraction-status.rejected {\n  color: #d99790;\n}\n\n.extraction-candidate-meta {\n  margin: 6px 0;\n}\n\n.extraction-candidate blockquote {\n  margin: 8px 0 10px;\n  padding: 9px 11px;\n  border-left: 2px solid #648b76;\n  border-radius: 0 6px 6px 0;\n  background: #1b2421;\n  color: #c2d1ca;\n  font-size: 10px;\n  line-height: 1.65;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.extraction-review-fields {\n  display: grid;\n  grid-template-columns: minmax(170px, 1.5fr) minmax(120px, 0.8fr) minmax(\n      120px,\n      0.8fr\n    );\n  gap: 8px;\n  margin-bottom: 10px;\n}\n\n.extraction-review-actions {\n  justify-content: flex-end;\n}\n\n@media (max-width: 1050px) {\n  .extraction-control-row {\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .extraction-run {\n    grid-column: 1 / -1;\n  }\n}\n\n@media (max-width: 700px) {\n  .extraction-review-fields {\n    grid-template-columns: 1fr;\n  }\n}\n\n.story-hub {\n  margin-bottom: 14px;\n}\n.story-hub-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n}\n.story-hub-form {\n  display: grid;\n  align-content: start;\n  gap: 4px;\n  border: 1px solid #2b3735;\n  background: #151c1d;\n  border-radius: 11px;\n  padding: 14px;\n}\n.story-hub-title {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin: 1px 0 7px;\n}\n.story-hub-title > span {\n  width: 25px;\n  height: 25px;\n  display: grid;\n  place-items: center;\n  border: 1px solid #385347;\n  border-radius: 8px;\n  color: #b5ddc7;\n  font-size: 10px;\n}\n.story-hub-title strong,\n.story-hub-title small {\n  display: block;\n}\n.story-hub-title strong {\n  font-size: 11px;\n  color: #dce7e1;\n}\n.story-hub-title small {\n  font-size: 8px;\n  color: #83918c;\n  margin-top: 3px;\n}\n.story-hub-form .field-label {\n  margin: 6px 0;\n}\n.story-hub-form textarea,\n.story-hub-form input,\n.story-hub-form select,\n.story-start-adventure input,\n.story-start-adventure select,\n.story-hero-create input {\n  width: 100%;\n  border: 1px solid #303a3c;\n  background: #111719;\n  color: var(--text);\n  border-radius: 7px;\n  padding: 9px 10px;\n  outline: none;\n  font-size: 10px;\n}\n.story-hub-form textarea {\n  resize: vertical;\n  line-height: 1.55;\n}\n.story-hero-create {\n  display: flex;\n  gap: 7px;\n  align-items: center;\n}\n.story-hero-create input {\n  flex: 1;\n  min-width: 0;\n}\n.story-start-adventure {\n  display: grid;\n  gap: 3px;\n  margin-top: 5px;\n  padding-top: 8px;\n  border-top: 1px solid #283432;\n}\n.story-adventure-list {\n  display: grid;\n  gap: 8px;\n  margin-top: 14px;\n}\n.story-adventure-list-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.story-adventure-list-heading strong {\n  font:\n    600 10px Manrope,\n    sans-serif;\n}\n.story-adventure-list-heading small {\n  color: #80908b;\n  font-size: 8px;\n}\n.story-adventure-card {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n  border: 1px solid #2b3735;\n  background: #171f20;\n  border-radius: 9px;\n  padding: 10px 12px;\n}\n.story-adventure-card > div {\n  min-width: 0;\n}\n.story-adventure-card strong,\n.story-adventure-card small {\n  display: block;\n}\n.story-adventure-card strong {\n  font-size: 10px;\n  color: #d7e2dc;\n}\n.story-adventure-card small {\n  font-size: 8px;\n  color: #82918a;\n  margin-top: 4px;\n}\n.story-branch-note {\n  margin: 12px 0 0;\n  color: #a4c6b2;\n  font-size: 9px;\n}\n.story-side-panels {\n  display: grid;\n  gap: 14px;\n  align-content: start;\n}\n.rpg-state-panel .panel-heading p {\n  max-width: 260px;\n}\n.rpg-location {\n  display: grid;\n  gap: 5px;\n  padding: 10px 11px;\n  margin: 3px 0 11px;\n  border: 1px solid #35453d;\n  border-radius: 9px;\n  background: #19231f;\n}\n.rpg-location small {\n  font-size: 8px;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  color: #83998c;\n}\n.rpg-location strong {\n  font-size: 11px;\n  font-weight: 500;\n  color: #c6e2d0;\n}\n.rpg-stat-list,\n.rpg-tracker-list {\n  display: grid;\n  gap: 7px;\n  margin: 10px 0;\n}\n.rpg-stat-list > strong,\n.rpg-tracker-list > strong {\n  font-size: 9px;\n  color: #87958f;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n.rpg-stat-list > div {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n}\n.rpg-stat-list span {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  border: 1px solid #303d38;\n  background: #18201e;\n  border-radius: 7px;\n  padding: 6px 8px;\n  color: #a8b9b0;\n  font-size: 8px;\n  text-transform: capitalize;\n}\n.rpg-stat-list b {\n  color: #c7e0d1;\n  font-size: 10px;\n}\n.rpg-tracker-list > div {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  gap: 5px 10px;\n  align-items: center;\n  border-bottom: 1px solid #283331;\n  padding: 6px 0;\n}\n.rpg-tracker-list span,\n.rpg-tracker-list b {\n  font-size: 9px;\n  color: #b7c4bd;\n  text-transform: capitalize;\n}\n.rpg-tracker-list b {\n  font-variant-numeric: tabular-nums;\n}\n.rpg-tracker-list meter {\n  grid-column: 1/-1;\n  width: 100%;\n  height: 6px;\n  accent-color: #76aa8d;\n}\n.rpg-check-form,\n.rpg-proposal-form {\n  display: grid;\n  gap: 3px;\n  border-top: 1px solid #2c3834;\n  margin-top: 12px;\n  padding-top: 11px;\n}\n.rpg-check-fields {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n}\n.rpg-check-fields .field-label {\n  min-width: 0;\n}\n.rpg-check-fields input,\n.rpg-check-fields select,\n.rpg-proposal-form input,\n.rpg-proposal-form select {\n  width: 100%;\n  height: 35px;\n  background: #111719;\n  color: var(--text);\n  border: 1px solid #303a3c;\n  border-radius: 7px;\n  padding: 0 9px;\n  font-size: 9px;\n}\n.rpg-last-check {\n  display: grid;\n  gap: 4px;\n  border: 1px solid #41413a;\n  border-left: 3px solid #c4a86d;\n  border-radius: 8px;\n  background: #201f1a;\n  padding: 9px 10px;\n  margin-top: 10px;\n}\n.rpg-last-check.success {\n  border-color: #385347;\n  border-left-color: #78b291;\n  background: #19231f;\n}\n.rpg-last-check strong {\n  font-size: 9px;\n  color: #d8c18d;\n  text-transform: capitalize;\n}\n.rpg-last-check.success strong {\n  color: #a8d5b8;\n}\n.rpg-last-check span {\n  font-size: 9px;\n  color: #bcc8c1;\n  font-variant-numeric: tabular-nums;\n}\n.rpg-proposal-section {\n  margin-top: 12px;\n  border-top: 1px solid #2c3834;\n  padding-top: 10px;\n}\n.rpg-proposal-section > summary {\n  cursor: pointer;\n  color: #b9c8c0;\n  font-size: 9px;\n}\n.rpg-proposal {\n  display: grid;\n  gap: 8px;\n  border: 1px solid #343d38;\n  border-radius: 8px;\n  padding: 9px;\n  margin-top: 8px;\n  background: #171e1c;\n}\n.rpg-proposal > div:first-child strong,\n.rpg-proposal > div:first-child small {\n  display: block;\n}\n.rpg-proposal strong {\n  font-size: 9px;\n  color: #d2ded7;\n}\n.rpg-proposal small {\n  font-size: 8px;\n  line-height: 1.5;\n  color: #91a098;\n  margin-top: 4px;\n}\n.rpg-proposal.accepted {\n  opacity: 0.72;\n  border-left: 2px solid #6eaa86;\n}\n.rpg-proposal.rejected {\n  opacity: 0.58;\n  border-left: 2px solid #8c6865;\n}\n.rpg-proposal-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 7px;\n}\n.rpg-proposal-actions button {\n  border: 1px solid #394740;\n  border-radius: 6px;\n  background: #202b26;\n  color: #b9d8c6;\n  padding: 5px 9px;\n  font-size: 8px;\n}\n.rpg-proposal-actions button:last-child {\n  background: #282120;\n  border-color: #493532;\n  color: #d3aaa3;\n}\n.story-side-panels .context-panel {\n  align-self: start;\n}\n.character-creation-rules,\n.character-creation-allocation {\n  display: grid;\n  gap: 8px;\n  margin: 8px 0;\n  padding: 11px;\n  border: 1px solid #303d38;\n  border-radius: 9px;\n  background: #131a1a;\n}\n.character-creation-rules > summary,\n.character-creation-review > summary {\n  cursor: pointer;\n  color: #b7c9be;\n  font-size: 9px;\n}\n.character-creation-rules > .field-label {\n  margin: 0;\n}\n.character-creation-rules input[type=\"number\"] {\n  font-variant-numeric: tabular-nums;\n}\n.character-creation-definition-list {\n  display: grid;\n  gap: 8px;\n}\n.character-creation-definition {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 4px 8px;\n  padding: 9px;\n  border: 1px solid #2a3632;\n  border-radius: 8px;\n  background: #171f1e;\n}\n.character-creation-definition .field-label {\n  min-width: 0;\n}\n.character-creation-definition .field-label input {\n  padding: 7px 8px;\n}\n.character-creation-definition .link-button {\n  justify-self: start;\n}\n.character-creation-allocation {\n  margin: 10px 0;\n}\n.character-creation-allocation-list {\n  display: grid;\n  gap: 5px;\n}\n.character-creation-allocation-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  border-bottom: 1px solid #293531;\n  padding: 7px 0;\n}\n.character-creation-allocation-row > span strong,\n.character-creation-allocation-row > span small {\n  display: block;\n}\n.character-creation-allocation-row > span strong {\n  font-size: 9px;\n  color: #d4e0d9;\n}\n.character-creation-allocation-row > span small {\n  font-size: 7px;\n  color: #82918b;\n  margin-top: 3px;\n}\n.character-creation-allocation-row > div {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.character-creation-allocation-row button {\n  min-width: 28px;\n  padding: 4px 8px !important;\n}\n.character-creation-allocation-row output {\n  min-width: 18px;\n  text-align: center;\n  color: #d4e7dc;\n  font-size: 11px;\n  font-variant-numeric: tabular-nums;\n}\n.character-creation-allocation-actions {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n.character-creation-allocation-actions strong {\n  color: #b9d8c6;\n  font-size: 8px;\n  font-variant-numeric: tabular-nums;\n}\n.character-creation-review {\n  border-top: 1px solid #293531;\n  padding-top: 7px;\n}\n.character-creation-review ul {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 4px 12px;\n  margin: 7px 0 0;\n  padding-inline-start: 17px;\n  color: #91a49a;\n  font-size: 8px;\n}\n@media (max-width: 950px) {\n  .story-hub-grid {\n    grid-template-columns: 1fr;\n  }\n  .story-side-panels {\n    grid-template-columns: 1fr;\n  }\n  .story-adventure-card {\n    align-items: flex-start;\n  }\n  .story-adventure-card .secondary-button {\n    flex: none;\n  }\n  .character-creation-definition {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .character-creation-review ul {\n    grid-template-columns: 1fr;\n  }\n}\n.rpg-edit-stats {\n  margin-top: 8px;\n}\n.rpg-edit-stats > summary {\n  cursor: pointer;\n  font-size: 8px;\n  color: #9aaba2;\n}\n.rpg-edit-stats form {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 3px 8px;\n  margin-top: 8px;\n}\n.rpg-edit-stats .field-label {\n  margin: 4px 0;\n  font-size: 8px;\n  text-transform: capitalize;\n}\n.rpg-edit-stats .field-label input {\n  width: 100%;\n  height: 31px;\n  background: #111719;\n  color: var(--text);\n  border: 1px solid #303a3c;\n  border-radius: 6px;\n  padding: 0 8px;\n  font-size: 9px;\n}\n.rpg-edit-stats button {\n  grid-column: 1/-1;\n}\n.story-world-editor {\n  margin-top: 12px;\n  padding: 11px 12px;\n  border: 1px solid #2b3735;\n  border-radius: 9px;\n  background: #141b1c;\n}\n.story-world-editor > summary {\n  cursor: pointer;\n  color: #b7c9bf;\n  font-size: 9px;\n}\n.story-world-editor > .field-note {\n  margin: 7px 0 9px;\n}\n.story-world-editor form {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 4px 10px;\n}\n.story-world-editor .field-label {\n  margin: 4px 0;\n}\n.story-world-editor .field-label:last-of-type {\n  grid-column: 1/-1;\n}\n.story-world-editor input,\n.story-world-editor textarea {\n  width: 100%;\n  border: 1px solid #303a3c;\n  background: #111719;\n  color: var(--text);\n  border-radius: 7px;\n  padding: 9px 10px;\n  font-size: 10px;\n}\n.story-world-editor textarea {\n  resize: vertical;\n  line-height: 1.55;\n}\n.story-world-editor-actions {\n  grid-column: 1/-1;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n.story-world-editor-actions small {\n  font-size: 8px;\n  color: #84948b;\n}\n.story-world-editor form > details {\n  grid-column: 1/-1;\n}\n@media (max-width: 700px) {\n  .story-world-editor form {\n    grid-template-columns: 1fr;\n  }\n}\n.rpg-proposal-edit {\n  display: grid;\n  gap: 8px;\n  padding-top: 8px;\n  border-top: 1px solid #303a35;\n}\n.rpg-proposal-edit .field-label {\n  margin: 0;\n  color: #aab6b2;\n  font-size: 8px;\n}\n.rpg-proposal-edit input,\n.rpg-proposal-edit select {\n  width: 100%;\n  height: 32px;\n  background: #111719;\n  color: var(--text);\n  border: 1px solid #303a3c;\n  border-radius: 6px;\n  padding: 0 8px;\n  font-size: 9px;\n}\n.exceptional-ability-editor {\n  margin-top: 0.85rem;\n}\n.exceptional-ability-definition {\n  min-width: 0;\n  margin: 0.75rem 0;\n  padding: 0.85rem;\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  display: grid;\n  gap: 0.7rem;\n}\n.exceptional-ability-definition legend {\n  padding: 0 0.4rem;\n  color: var(--ink);\n  font-weight: 700;\n}\n.exceptional-ability-definition .character-creation-definition {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n.exceptional-ability-definition textarea {\n  min-height: 4.5rem;\n  resize: vertical;\n}\n.rpg-ability-list {\n  display: grid;\n  gap: 0.75rem;\n  margin: 1rem 0;\n  padding: 1rem;\n  border: 1px solid var(--line);\n  border-radius: 14px;\n  background: var(--surface-soft);\n}\n.rpg-ability-card {\n  display: grid;\n  gap: 0.65rem;\n  padding: 0.9rem;\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  background: var(--surface);\n}\n.rpg-ability-card.active {\n  border-color: var(--accent);\n  box-shadow: inset 3px 0 var(--accent);\n}\n.rpg-ability-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n}\n.rpg-ability-heading > div {\n  display: grid;\n  gap: 0.2rem;\n}\n.rpg-ability-heading small,\n.rpg-ability-card > small {\n  color: var(--muted);\n}\n.rpg-ability-facts {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n.rpg-ability-facts span {\n  display: grid;\n  gap: 0.15rem;\n  color: var(--muted);\n  font-size: 0.88rem;\n}\n.rpg-ability-facts b,\n.rpg-ability-list-section > b {\n  color: var(--ink);\n}\n.rpg-ability-list-section ul {\n  margin: 0.3rem 0;\n  padding-inline-start: 1.2rem;\n  color: var(--muted);\n}\n.rpg-ability-list-section li {\n  padding: 0.12rem 0;\n}\n@media (max-width: 680px) {\n  .exceptional-ability-definition .character-creation-definition,\n  .rpg-ability-facts {\n    grid-template-columns: 1fr;\n  }\n  .rpg-ability-heading {\n    align-items: flex-start;\n  }\n}\n.rpg-experience-card {\n  display: grid;\n  gap: 7px;\n  margin: 10px 0;\n  padding: 10px 11px;\n  border: 1px solid #304039;\n  border-radius: 9px;\n  background: linear-gradient(140deg, #19231f, #151c1d);\n}\n.rpg-experience-card > div {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n}\n.rpg-experience-card > div strong {\n  font-size: 9px;\n  color: #8fa99a;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n.rpg-experience-card > div b {\n  color: #d2e8d8;\n  font-size: 11px;\n  font-variant-numeric: tabular-nums;\n}\n.rpg-experience-card > small {\n  color: #91a098;\n  font-size: 8px;\n  line-height: 1.5;\n}\n.story-setup-progress {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 7px;\n  margin: 0 0 12px;\n  padding: 0;\n  list-style: none;\n}\n.story-setup-progress li {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  padding: 8px;\n  border: 1px solid #2d3935;\n  border-radius: 8px;\n  background: #141b1b;\n  color: #82918a;\n}\n.story-setup-progress li[aria-current=\"step\"] {\n  border-color: #628f75;\n  background: #1a2721;\n  color: #d2e6d8;\n}\n.story-setup-progress li.complete {\n  color: #a8c4b2;\n}\n.story-setup-progress li span {\n  display: grid;\n  place-items: center;\n  flex: none;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background: #27332e;\n  font-size: 9px;\n  font-weight: 700;\n}\n.story-setup-progress li[aria-current=\"step\"] span,\n.story-setup-progress li.complete span {\n  background: #557b64;\n  color: #fff;\n}\n.story-setup-progress li small {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 9px;\n}\n.story-setup-stage {\n  grid-template-columns: minmax(0, 1fr);\n}\n.story-hub-create-world {\n  margin-top: 10px;\n}\n.story-world-advanced {\n  margin-top: 8px;\n}\n.wizard-actions {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 9px;\n  margin-top: 10px;\n}\n.wizard-actions button {\n  min-width: 110px;\n}\n.story-setup-model {\n  display: grid;\n  gap: 7px;\n  margin-top: 8px;\n  padding: 12px;\n  border: 1px solid #303d38;\n  border-radius: 9px;\n  background: #131a1a;\n}\n.story-setup-model h3 {\n  margin: 0;\n  color: #d1ded6;\n  font-size: 10px;\n}\n.story-setup-model .field-note,\n.story-setup-model .provider-note {\n  margin: 0;\n}\n.story-setup-model .story-provider-fields {\n  margin-top: 0;\n}\n@media (max-width: 520px) {\n  .story-setup-progress {\n    gap: 4px;\n  }\n  .story-setup-progress li {\n    gap: 5px;\n    padding: 6px 4px;\n  }\n  .story-setup-progress li small {\n    font-size: 8px;\n  }\n  .wizard-actions {\n    align-items: stretch;\n  }\n  .wizard-actions button {\n    min-width: 0;\n    flex: 1;\n  }\n}\n.story-library-tools {\n  display: grid;\n  grid-template-columns: minmax(220px, 2fr) repeat(5, minmax(125px, 1fr));\n  gap: 7px;\n  margin: 12px 0;\n}\n.story-library-tools input,\n.story-library-tools select,\n.story-card-actions select,\n.story-card-rename input {\n  min-width: 0;\n  width: 100%;\n  height: 34px;\n  padding: 0 9px;\n  border: 1px solid #303a3c;\n  border-radius: 7px;\n  background: #111719;\n  color: var(--text);\n  font-size: 9px;\n}\n.story-most-recent {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n  border: 1px solid #3b5546;\n  border-left: 3px solid #75a988;\n  border-radius: 9px;\n  padding: 10px 12px;\n  background: #19231e;\n}\n.story-most-recent strong,\n.story-most-recent small,\n.story-library-card-main strong,\n.story-library-card-main small {\n  display: block;\n}\n.story-most-recent strong {\n  font-size: 9px;\n  color: #c9e0d2;\n}\n.story-most-recent small {\n  margin-top: 4px;\n  color: #91a49a;\n  font-size: 8px;\n}\n.story-library-card-main {\n  flex: 1;\n  min-width: 150px;\n}\n.story-adventure-card {\n  align-items: flex-start;\n  flex-wrap: wrap;\n}\n.story-card-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 5px;\n  flex-wrap: wrap;\n}\n.story-card-actions button {\n  white-space: nowrap;\n}\n.story-card-actions select {\n  width: auto;\n  max-width: 140px;\n  height: 30px;\n  padding: 0 7px;\n}\n.story-card-rename {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  min-width: min(420px, 100%);\n}\n.story-card-rename input {\n  flex: 1;\n}\n.story-world-library {\n  margin-top: 12px;\n  padding: 10px 12px;\n  border: 1px solid #2b3735;\n  border-radius: 9px;\n  background: #141b1c;\n}\n.story-world-library > summary {\n  cursor: pointer;\n  color: #b7c9bf;\n  font-size: 9px;\n}\n.story-world-library > summary small {\n  margin-left: 6px;\n  color: #82918a;\n}\n.story-world-library-list {\n  display: grid;\n  gap: 7px;\n  margin-top: 9px;\n}\n.story-world-library-list article {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 9px;\n  border: 1px solid #2c3934;\n  border-radius: 8px;\n  background: #171f20;\n}\n.story-library-card-main strong {\n  font-size: 9px;\n  color: #d7e2dc;\n}\n.story-library-card-main small {\n  margin-top: 4px;\n  color: #82918a;\n  font-size: 8px;\n  line-height: 1.4;\n}\n@media (max-width: 1000px) {\n  .story-library-tools {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n  .story-library-tools input {\n    grid-column: span 3;\n  }\n}\n@media (max-width: 650px) {\n  .story-library-tools {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .story-library-tools input {\n    grid-column: 1/-1;\n  }\n  .story-adventure-card,\n  .story-world-library-list article {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    align-items: stretch;\n  }\n  .story-card-actions {\n    justify-content: flex-start;\n  }\n  .story-card-actions select {\n    flex: 1;\n    max-width: none;\n  }\n  .story-most-recent {\n    align-items: flex-start;\n  }\n  .story-card-rename {\n    min-width: 0;\n    flex-wrap: wrap;\n  }\n}\n.story-start-summary {\n  display: grid;\n  gap: 8px;\n}\n.story-start-summary img,\n.story-world-cover-preview img {\n  display: block;\n  width: min(100%, 420px);\n  max-height: 210px;\n  object-fit: cover;\n  border: 1px solid #35433c;\n  border-radius: 9px;\n  background: #151d19;\n}\n.story-world-cover-preview {\n  display: grid;\n  justify-items: start;\n  gap: 7px;\n  padding: 9px;\n  border: 1px solid #303a35;\n  border-radius: 8px;\n  background: #141b1a;\n}\n.story-world-cover-preview .field-label {\n  width: min(100%, 420px);\n  margin: 0;\n}\n.story-world-cover-preview .quiet-button {\n  justify-self: start;\n}\n\n/* Keep frequent library tasks visible; reveal refinement and maintenance controls on demand. */\n.story-library-tools {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: 9px;\n  margin: 12px 0;\n}\n.story-library-search-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.story-library-search-row input {\n  flex: 1;\n  min-width: 0;\n  min-height: 42px;\n  padding: 0 12px;\n  border: 1px solid #3a4946;\n  border-radius: 8px;\n  background: #111719;\n  color: var(--text);\n  font-size: 13px;\n}\n.story-library-search-row input:focus-visible,\n.story-library-filter-grid select:focus-visible,\n.story-card-menu > summary:focus-visible,\n.story-library-filters > summary:focus-visible {\n  outline: 2px solid #91c6a8;\n  outline-offset: 2px;\n}\n.story-library-search-row .quiet-button {\n  min-height: 42px;\n  padding: 8px 12px;\n  border: 1px solid #35433e;\n  border-radius: 8px;\n  font-size: 12px;\n}\n.story-library-filters {\n  border: 1px solid #2e3c38;\n  border-radius: 9px;\n  background: #141b1c;\n}\n.story-library-filters > summary {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  min-height: 42px;\n  padding: 8px 12px;\n  cursor: pointer;\n  color: #c1d0c8;\n  font-size: 12px;\n  font-weight: 600;\n  list-style-position: inside;\n}\n.story-library-filters > summary small {\n  color: #91aa9b;\n  font-size: 11px;\n  font-weight: 500;\n}\n.story-library-filter-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));\n  gap: 10px;\n  padding: 12px;\n  border-top: 1px solid #283632;\n}\n.story-library-filter-grid > label {\n  display: grid;\n  align-content: start;\n  gap: 5px;\n  color: #a9bab1;\n  font-size: 11px;\n  font-weight: 600;\n}\n.story-library-filter-grid select {\n  width: 100%;\n  min-width: 0;\n  min-height: 40px;\n  padding: 0 10px;\n  border: 1px solid #35433f;\n  border-radius: 7px;\n  background: #111719;\n  color: var(--text);\n  font-size: 12px;\n}\n.story-library-clear {\n  grid-column: 1/-1;\n  justify-self: end;\n  min-height: 38px;\n  font-size: 12px;\n}\n.story-adventure-list {\n  gap: 9px;\n  margin-top: 15px;\n}\n.story-adventure-list-heading {\n  gap: 12px;\n  flex-wrap: wrap;\n}\n.story-adventure-list-heading > div {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n}\n.story-adventure-list-heading strong {\n  font-size: 13px;\n}\n.story-adventure-list-heading small {\n  font-size: 11px;\n}\n.story-new-adventure {\n  min-height: 40px;\n  padding: 8px 13px;\n  font-size: 12px;\n  white-space: nowrap;\n}\n.story-most-recent {\n  min-height: 66px;\n  padding: 12px 14px;\n}\n.story-most-recent strong {\n  font-size: 12px;\n}\n.story-most-recent small {\n  font-size: 11px;\n  line-height: 1.45;\n}\n.story-adventure-card,\n.story-world-library-list article {\n  align-items: center;\n  padding: 13px 15px;\n  border-radius: 10px;\n}\n.story-library-card-main {\n  flex: 1;\n  min-width: 0;\n}\n.story-library-card-main strong {\n  font-size: 13px;\n  line-height: 1.4;\n}\n.story-library-card-main small {\n  font-size: 11px;\n  line-height: 1.5;\n  overflow-wrap: anywhere;\n}\n.story-adventure-card .story-card-actions,\n.story-world-library-list article .story-card-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 7px;\n  flex: 0 0 auto;\n  flex-wrap: wrap;\n}\n.story-more-adventures {\n  border: 1px solid #2e3c38;\n  border-radius: 9px;\n  background: #141b1c;\n}\n.story-more-adventures > summary {\n  min-height: 42px;\n  padding: 11px 13px;\n  cursor: pointer;\n  color: #b9c9c0;\n  font-size: 12px;\n  font-weight: 600;\n}\n.story-more-adventures-list {\n  display: grid;\n  gap: 9px;\n  padding: 0 9px 9px;\n}\n.story-card-actions > .secondary-button {\n  min-height: 38px;\n  padding: 8px 12px;\n  font-size: 12px;\n}\n.story-card-menu {\n  position: relative;\n}\n.story-card-menu > summary {\n  display: flex;\n  align-items: center;\n  min-height: 38px;\n  padding: 7px 11px;\n  border: 1px solid #35433f;\n  border-radius: 7px;\n  background: #18201f;\n  color: #c1d0c8;\n  cursor: pointer;\n  font-size: 12px;\n  list-style-position: inside;\n}\n.story-card-menu > summary:hover {\n  border-color: #557562;\n  color: #d7eadf;\n}\n.story-card-menu-panel {\n  position: absolute;\n  top: calc(100% + 5px);\n  right: 0;\n  z-index: 10;\n  display: grid;\n  gap: 3px;\n  min-width: 210px;\n  padding: 8px;\n  border: 1px solid #43544b;\n  border-radius: 9px;\n  background: #151d1c;\n  box-shadow: 0 12px 28px #0008;\n}\n.story-card-menu-panel > .quiet-button {\n  width: 100%;\n  min-height: 36px;\n  padding: 8px 10px;\n  border-radius: 6px;\n  text-align: left;\n  font-size: 12px;\n}\n.story-card-menu-panel > .quiet-button:hover {\n  background: #202d28;\n}\n.story-card-status-field {\n  display: grid;\n  gap: 4px;\n  padding: 5px 9px;\n  color: #91a59a;\n  font-size: 11px;\n}\n.story-card-status-field select {\n  width: 100%;\n  min-height: 36px;\n  padding: 0 9px;\n  border: 1px solid #35433f;\n  border-radius: 6px;\n  background: #111719;\n  color: var(--text);\n  font-size: 12px;\n}\n.story-card-rename {\n  min-width: min(380px, 100%);\n}\n.story-card-rename input {\n  min-height: 38px;\n  font-size: 12px;\n}\n.story-world-library {\n  margin-top: 13px;\n  padding: 12px 14px;\n}\n.story-world-library > summary {\n  font-size: 12px;\n}\n.story-world-library > summary small {\n  font-size: 11px;\n}\n.story-world-library-list {\n  gap: 9px;\n  margin-top: 12px;\n}\n.story-library-empty {\n  display: grid;\n  justify-items: start;\n  gap: 4px;\n}\n.story-library-empty .empty-hint {\n  margin: 7px 0 0;\n  font-size: 12px;\n  line-height: 1.55;\n}\n.story-library-empty .quiet-button {\n  min-height: 36px;\n  font-size: 12px;\n}\n@media (max-width: 650px) {\n  .story-adventure-list-heading {\n    align-items: stretch;\n  }\n  .story-new-adventure {\n    width: 100%;\n  }\n  .story-adventure-card,\n  .story-world-library-list article {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n    align-items: stretch;\n    gap: 10px;\n  }\n  .story-adventure-card .story-card-actions,\n  .story-world-library-list article .story-card-actions {\n    width: 100%;\n    justify-content: flex-start;\n  }\n  .story-card-menu-panel {\n    left: 0;\n    right: auto;\n  }\n  .story-card-rename {\n    min-width: 0;\n    flex-wrap: wrap;\n  }\n  .story-most-recent {\n    align-items: center;\n  }\n}\n\n/* Keep world authoring short at first, then reveal optional mechanics in a final step. */\n.story-world-editor .story-hub-create-world {\n  grid-template-columns: minmax(0, 1fr);\n  gap: 12px;\n}\n.world-creation-progress {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n.world-creation-progress li {\n  display: grid;\n  justify-items: center;\n  gap: 5px;\n  min-width: 0;\n  padding: 9px 7px;\n  border: 1px solid #2e3c38;\n  border-radius: 8px;\n  background: #141b1c;\n  color: #86968d;\n  text-align: center;\n}\n.world-creation-progress li > span {\n  display: grid;\n  place-items: center;\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  background: #26322d;\n  color: #b8c9bf;\n  font-size: 11px;\n  font-weight: 700;\n}\n.world-creation-progress li[aria-current=\"step\"] {\n  border-color: #628f75;\n  background: #1a2721;\n  color: #d2e6d8;\n}\n.world-creation-progress li[aria-current=\"step\"] > span,\n.world-creation-progress li.complete > span {\n  background: #557b64;\n  color: #fff;\n}\n.world-creation-progress li small {\n  font-size: 11px;\n  line-height: 1.35;\n}\n.world-creation-stage {\n  display: grid;\n  gap: 12px;\n}\n.world-creation-step-heading {\n  display: grid;\n  gap: 4px;\n}\n.world-creation-step-heading h3 {\n  margin: 0;\n  color: #d5e2da;\n  font-size: 15px;\n}\n.world-creation-step-heading p {\n  margin: 0;\n  color: #9baca2;\n  font-size: 12px;\n  line-height: 1.5;\n}\n.world-creation-stage > .story-start-summary {\n  padding: 10px 12px;\n  border: 1px solid #33443b;\n  border-radius: 8px;\n  background: #151d19;\n  color: #c3d5ca;\n  font-size: 12px;\n  line-height: 1.5;\n}\n.world-creation-stage > .story-start-summary strong {\n  color: #e0ece4;\n}\n.world-creation-review {\n  display: grid;\n  gap: 5px;\n}\n.world-creation-review h4,\n.world-creation-review p {\n  margin: 0;\n}\n.world-creation-review > div {\n  display: grid;\n  gap: 5px;\n}\n.world-creation-review img {\n  display: block;\n  width: min(100%, 420px);\n  max-height: 210px;\n  object-fit: cover;\n  border: 1px solid #35433c;\n  border-radius: 8px;\n}\n.world-creation-fields {\n  display: grid;\n  gap: 7px;\n  padding: 12px;\n  border: 1px solid #2e3c38;\n  border-radius: 8px;\n  background: #141b1c;\n}\n.world-creation-fields h4 {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 0;\n  color: #d2dfd7;\n  font-size: 13px;\n}\n.world-creation-fields h4 span {\n  padding: 2px 7px;\n  border: 1px solid #34443b;\n  border-radius: 99px;\n  color: #9eb3a5;\n  font-size: 10px;\n  font-weight: 500;\n}\n.world-creation-fields .field-note {\n  margin: 0;\n  line-height: 1.5;\n}\n.world-creation-actions {\n  padding-top: 4px;\n  border-top: 1px solid #2a3732;\n}\n.world-creation-actions button {\n  min-height: 40px;\n  font-size: 12px;\n}\n@media (max-width: 520px) {\n  .world-creation-progress {\n    gap: 5px;\n  }\n  .world-creation-progress li {\n    padding: 7px 4px;\n  }\n  .world-creation-progress li small {\n    font-size: 10px;\n  }\n  .world-creation-actions button {\n    min-width: 0;\n    flex: 1;\n  }\n}\n.hero-identity-form,\n.hero-identity-section {\n  display: grid;\n  gap: 9px;\n  min-width: 0;\n}\n.hero-identity-form > .field-label {\n  margin: 0;\n}\n.hero-identity-form > strong {\n  color: #dce7e1;\n  font-size: 11px;\n}\n.hero-profile-details,\n.hero-profile-review {\n  border: 1px solid #2d3a35;\n  border-radius: 8px;\n  background: #141b1b;\n  padding: 9px 10px;\n}\n.hero-profile-details > summary,\n.hero-profile-review > summary {\n  cursor: pointer;\n  color: #bdd3c5;\n  font-size: 10px;\n}\n.hero-profile-details[open] > summary,\n.hero-profile-review[open] > summary {\n  margin-bottom: 8px;\n}\n.hero-profile-details > .field-note,\n.hero-profile-review > .field-note {\n  margin: 6px 0 0;\n  line-height: 1.5;\n}\n.hero-profile-fields {\n  display: grid;\n  gap: 7px;\n}\n.hero-profile-fields .field-label {\n  margin: 0;\n}\n.hero-profile-review dl {\n  display: grid;\n  gap: 7px;\n  margin: 0;\n}\n.hero-profile-review dl > div {\n  display: grid;\n  gap: 2px;\n}\n.hero-profile-review dt {\n  color: #9fb4a6;\n  font-size: 9px;\n  font-weight: 600;\n}\n.hero-profile-review dd {\n  margin: 0;\n  color: #d0dbd4;\n  font-size: 10px;\n  line-height: 1.5;\n  overflow-wrap: anywhere;\n}\n.hero-profile-review-list {\n  display: grid;\n  gap: 7px;\n  margin: 8px 0;\n}\n.hero-profile-review-list > div {\n  display: grid;\n  gap: 2px;\n}\n.hero-profile-review-list dt {\n  color: #9fb4a6;\n  font-size: 9px;\n  font-weight: 600;\n}\n.hero-profile-review-list dd {\n  margin: 0;\n  color: #d0dbd4;\n  font-size: 10px;\n  line-height: 1.5;\n  overflow-wrap: anywhere;\n}\n.rpg-hero-identity > .field-note {\n  line-height: 1.5;\n}\n.rpg-edit-stats .hero-identity-form {\n  grid-template-columns: minmax(0, 1fr);\n}\n.mno-lorebook-editor {\n  grid-column: 1/-1;\n  min-width: 0;\n}\n.mno-lorebook-editor > .field-note {\n  line-height: 1.55;\n}\n.mno-lorebook-editor > label input {\n  width: 100%;\n  border: 1px solid #303a3c;\n  background: #1