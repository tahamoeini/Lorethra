ip_to_actor\"] {\n  min-height: 72px;\n  resize: vertical;\n}\n\n/* Keep the everyday path short and readable; less common tools stay available on demand. */\nbody {\n  min-width: 320px;\n}\n.sidebar-more-tools {\n  margin-top: 14px;\n  border-top: 1px solid var(--line);\n  padding-top: 12px;\n}\n.sidebar-more-tools > summary {\n  display: grid;\n  gap: 4px;\n  cursor: pointer;\n  padding: 8px 12px;\n  border-radius: 9px;\n  color: #c4d1cb;\n  font-size: 13px;\n  font-weight: 600;\n  list-style-position: inside;\n}\n.sidebar-more-tools > summary:hover,\n.project-options > summary:hover {\n  background: #1a2224;\n}\n.sidebar-more-tools > summary small {\n  padding-left: 20px;\n  color: #899791;\n  font-size: 11px;\n  font-weight: 400;\n}\n.sidebar-more-tools nav {\n  display: grid;\n  gap: 4px;\n  margin-top: 5px;\n}\n.sidebar-more-tools .nav-item {\n  width: 100%;\n  align-items: center;\n}\n.sidebar-bottom {\n  font-size: 12px;\n}\n.brand {\n  padding-bottom: 26px;\n}\n.brand strong {\n  font-size: 17px;\n}\n.brand span {\n  font-size: 9px;\n  letter-spacing: 0.12em;\n}\n.workspace-label {\n  font-size: 11px;\n  letter-spacing: 0.08em;\n}\n.workspace-select {\n  font-size: 13px;\n}\n.topbar {\n  position: relative;\n}\n.project-options {\n  position: relative;\n  flex: none;\n}\n.project-options > summary {\n  cursor: pointer;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 8px 11px;\n  color: #c2ccc7;\n  font-size: 12px;\n  list-style: none;\n}\n.project-options > summary::-webkit-details-marker {\n  display: none;\n}\n.project-options > summary::after {\n  content: \"⌄\";\n  padding-left: 8px;\n  color: #93a39b;\n}\n.project-options-menu {\n  position: absolute;\n  z-index: 10;\n  top: calc(100% + 7px);\n  right: 0;\n  display: grid;\n  gap: 7px;\n  min-width: 225px;\n  padding: 12px;\n  border: 1px solid #37433f;\n  border-radius: 11px;\n  background: #171e20;\n  box-shadow: 0 12px 32px #0008;\n}\n.project-options-menu label {\n  display: grid;\n  gap: 5px;\n  color: #aab8b1;\n  font-size: 12px;\n}\n.project-options-menu .branch-select {\n  width: 100%;\n  height: 36px;\n  background: #111719;\n  color: var(--text);\n  border: 1px solid var(--line);\n  border-radius: 7px;\n  padding: 0 8px;\n}\n.project-options-menu .quiet-button {\n  text-align: left;\n  min-height: 38px;\n  font-size: 12px;\n}\n.project-options-menu .revision-chip {\n  justify-self: start;\n  font-size: 11px;\n}\n.welcome-card .inline-create {\n  display: grid;\n  grid-template-columns: minmax(220px, 1fr) auto;\n  align-items: end;\n  gap: 10px;\n  max-width: 640px;\n  margin-top: 22px;\n}\n.welcome-card .field-label {\n  font-size: 13px;\n}\n.welcome-card .field-label input {\n  height: 46px;\n  font-size: 15px;\n}\n.welcome-card .primary-button {\n  min-height: 46px;\n  font-size: 14px;\n}\n.welcome-points {\n  margin-top: 18px;\n  color: #a8c7b3;\n  font-size: 12px;\n}\n.welcome-points > span {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n.page-content .field-label {\n  font-size: 12px;\n}\n.page-content input,\n.page-content select,\n.page-content textarea {\n  font-size: 13px;\n}\n.story-direction-label {\n  gap: 8px;\n  font-size: 14px !important;\n}\n.story-direction-label textarea {\n  min-height: 96px;\n  padding: 12px;\n  font-size: 15px;\n  line-height: 1.55;\n}\n.story-writing-settings {\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  background: #141b1c;\n  padding: 0 12px;\n}\n.story-writing-settings > summary {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  align-items: center;\n  gap: 10px;\n  min-height: 44px;\n  cursor: pointer;\n  color: #c5d1ca;\n  font-size: 13px;\n  font-weight: 600;\n}\n.story-writing-settings > summary small {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  color: #85948c;\n  font-size: 11px;\n  font-weight: 400;\n  text-align: right;\n}\n.story-writing-settings-body {\n  display: grid;\n  gap: 10px;\n  padding: 0 0 12px;\n}\n.story-writing-settings .provider-note,\n.story-writing-settings .field-note {\n  font-size: 12px;\n  line-height: 1.5;\n}\n.story-writing-settings .field-label select {\n  height: 40px;\n}\n.story-writing-settings .secondary-button {\n  min-height: 40px;\n  font-size: 12px;\n}\n.story-writing-settings .story-advanced-options {\n  border-top: 1px solid #293633;\n  padding-top: 8px;\n}\n.story-writing-settings .story-advanced-options > summary {\n  cursor: pointer;\n  color: #aebbb4;\n  font-size: 12px;\n}\n.story-compose-form > .primary-button {\n  min-height: 46px;\n  font-size: 14px;\n}\n\n@media (max-width: 760px) {\n  .app-shell {\n    display: block;\n  }\n  .sidebar {\n    position: relative;\n    inset: auto;\n    width: 100%;\n    min-height: 0;\n    border-right: 0;\n    border-bottom: 1px solid var(--line);\n    padding: 14px 16px;\n    gap: 0;\n  }\n  .brand {\n    padding: 0 4px 12px;\n  }\n  .workspace-label {\n    padding: 0 4px 6px;\n  }\n  .workspace-select {\n    max-width: 420px;\n    margin-bottom: 8px;\n  }\n  .primary-nav {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .sidebar-more-tools {\n    margin-top: 7px;\n    padding-top: 7px;\n  }\n  .sidebar-bottom {\n    display: none;\n  }\n  .main-area {\n    grid-column: auto;\n    min-width: 0;\n  }\n  .topbar {\n    height: auto;\n    min-height: 56px;\n    padding: 9px 16px;\n    gap: 10px;\n  }\n  .page-content {\n    padding: 20px 16px 44px;\n  }\n}\n@media (max-width: 520px) {\n  .welcome-card .inline-create {\n    grid-template-columns: 1fr;\n  }\n  .welcome-card .inline-create .primary-button {\n    width: 100%;\n  }\n  .topbar {\n    align-items: flex-start;\n  }\n  .project-options-menu {\n    position: fixed;\n    top: 56px;\n    right: 10px;\n    width: min(300px, calc(100vw - 20px));\n  }\n  .page-heading {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n  .page-heading h1,\n  .welcome-card h1 {\n    font-size: 26px;\n  }\n}\n"],["STYLE",{},"/* RPG authoring panels, continuity controls, and private reader */\n.story-detail-panel{padding:0;overflow:hidden}\n.story-detail-panel>summary{display:grid;gap:4px;padding:14px 16px;cursor:pointer;list-style:none}\n.story-detail-panel>summary::-webkit-details-marker{display:none}\n.story-detail-panel>summary:after{content:\"Open\";font-size:8px;color:#94aa9e;letter-spacing:.08em;text-transform:uppercase}\n.story-detail-panel[open]>summary:after{content:\"Close\"}\n.story-detail-panel>summary strong{font:600 13px Manrope,sans-serif;color:#dbe7e0}\n.story-detail-panel>summary small{font-size:9px;color:#86958e}\n.story-detail-content{display:grid;gap:12px;padding:0 14px 14px}\n.story-hub-setup>summary{display:flex;align-items:center;gap:8px;padding:11px 13px;border:1px solid #2c3935;border-radius:8px;background:#151d1d;color:#c8d7ce;font:600 10px Manrope,sans-serif;cursor:pointer;list-style:none}\n.story-hub-setup>summary::-webkit-details-marker{display:none}.story-hub-setup>summary:after{content:\"Open\";margin-inline-start:auto;color:#94aa9e;font-size:8px;text-transform:uppercase}.story-hub-setup[open]>summary:after{content:\"Close\"}\n.story-hub-setup[open] .story-hub-grid{padding-top:12px}\n.story-adventure-list{display:grid;gap:7px;margin:0 0 12px}.story-adventure-list-heading{display:flex;justify-content:space-between;align-items:center;color:#c8d7ce;font:600 10px Manrope,sans-serif}.story-adventure-list-heading small{color:#87968f;font-size:8px}\n.story-adventure-list-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap}.story-adventure-list-actions button{min-height:44px}\n.story-library-tools{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px;margin:10px 0}.story-library-tools input,.story-library-tools select{min-width:0;border:1px solid #303a3c;background:#111719;color:var(--text);border-radius:7px;padding:8px 9px;font-size:9px}.story-library-tools input::placeholder{color:#819087}\n.world-starter-action{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-block:4px 10px}.world-starter-action .quiet-button{min-height:44px;padding:8px 12px;font-size:12px}.world-starter-action small{color:#aebfb5;font-size:12px;line-height:1.5}\n.story-start-summary{margin:2px 0;padding:8px 9px;border-inline-start:2px solid #87b7a0;background:#141b1b;color:#aebfb5;font-size:8px;line-height:1.5}\n.story-world-library{margin:0 0 10px;border:1px solid #2a3632;border-radius:8px;background:#141b1b}.story-world-library>summary{display:flex;align-items:center;gap:8px;padding:9px 10px;color:#c8d7ce;font-size:9px;cursor:pointer;list-style:none}.story-world-library>summary::-webkit-details-marker{display:none}.story-world-library>summary small{margin-inline-start:auto;color:#87968f;font-size:8px}.story-world-library-list{display:grid;gap:5px;padding:0 9px 9px}.story-world-library-list article{display:flex;align-items:center;justify-content:space-between;gap:8px;border-top:1px solid #2c3733;padding:7px 0}.story-world-library-list article>div{display:grid;gap:3px;min-width:0}.story-world-library-list strong{font-size:9px;color:#c8d7ce}.story-world-library-list small{font-size:8px;color:#84938c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:52ch}.story-world-library-list .secondary-button{padding:5px 8px;font-size:8px}\n.story-adventure-card{display:flex;align-items:center;justify-content:space-between;gap:10px;border:1px solid #2a3632;border-radius:8px;background:#141b1b;padding:9px 10px}.story-adventure-card>div{display:grid;gap:3px;min-width:0}.story-adventure-card strong{font-size:10px;color:#d4e2d9}.story-adventure-card small{font-size:8px;color:#86958e}.story-adventure-card .secondary-button{flex:0 0 auto;padding:6px 9px;font-size:8px}\n.story-mini-form{display:grid;gap:8px;padding:11px;border:1px solid #2c3935;border-radius:9px;background:#151d1d}\n.story-mini-form>strong,.story-detail-heading>strong{font:600 10px Manrope,sans-serif;color:#cad8d0}\n.story-detail-heading{display:flex;align-items:center;justify-content:space-between;gap:8px}\n.story-mini-form textarea,.story-mini-form input,.story-mini-form select{width:100%;border:1px solid #303a3c;background:#111719;color:var(--text);border-radius:7px;padding:8px 9px;font-size:10px;line-height:1.5}\n.story-memory-list,.story-thread-list{display:grid;gap:8px}\n.story-memory-card,.story-thread-card,.story-npc-card{border:1px solid #2a3632;border-radius:9px;background:#141b1b;padding:10px}\n.story-memory-card.proposed{border-color:#514731}.story-memory-card.rejected{opacity:.7}\n.story-memory-meta{display:grid;gap:3px}.story-memory-meta strong,.story-thread-card strong,.story-npc-card strong{font-size:9px;color:#c8d7ce}\n.story-memory-meta small,.story-npc-card small,.story-thread-card small{font-size:8px;color:#84938c}\n.story-memory-card>p,.story-thread-card p,.story-npc-card p{font-size:9px;line-height:1.55;color:#aebdb5;white-space:pre-wrap;overflow-wrap:anywhere;margin:8px 0}\n.story-memory-actions,.story-turn-actions{display:flex;flex-wrap:wrap;gap:6px;align-items:center}\n.story-memory-actions button,.story-turn-actions button{border:1px solid #34423c;border-radius:6px;background:#1a2422;color:#b5c7bd;padding:5px 8px;font-size:8px;cursor:pointer}\n.story-memory-actions .accept-button{color:#bfe0c9;border-color:#42614f}\n.story-memory-actions details{width:100%;font-size:8px;color:#87968f}.story-memory-actions details p{font-size:8px;color:#9caaa3;white-space:pre-wrap}\n.story-provider-fields{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px}\n.memory-known-by{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:6px;border:1px solid #2a3632;border-radius:8px;padding:8px}\n.memory-known-by legend{font-size:8px;color:#9aa9a1;padding-inline:4px}\n.memory-known-by label{display:flex;align-items:center;gap:6px;font-size:8px;color:#b9c8c0}\n.memory-known-by input{accent-color:#a8c9b0}\n.story-context-details details{margin:6px 0;padding:5px;border:1px solid #28332f;border-radius:6px}\n.story-context-details details p{white-space:pre-wrap;font-size:8px;color:#aab8b0}\n.story-thread-card{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}.story-thread-card p{margin:4px 0 0}\n.story-npc-card .private-note{display:block;border-top:1px solid #2c3733;padding-top:6px;margin-top:6px;color:#ad9e79}\n.story-world-cast{border:1px solid #2a3632;border-radius:8px;padding:9px;background:#141b1b}.story-world-cast>summary{color:#c8d7ce;font-size:9px;cursor:pointer}.story-world-cast>p{margin:7px 0}.story-world-cast-list{display:grid;gap:5px}.story-world-cast-list article{display:flex;align-items:center;justify-content:space-between;gap:8px;border-top:1px solid #2c3733;padding:7px 0}.story-world-cast-list article>div{display:grid;gap:3px}.story-world-cast-list strong{font-size:9px;color:#c8d7ce}.story-world-cast-list small{font-size:8px;color:#84938c}.story-world-cast-list .secondary-button{padding:5px 8px;font-size:8px}\n.story-npc-heading{display:flex;align-items:center;gap:10px}.story-npc-heading img{width:48px;height:48px;flex:0 0 48px;object-fit:cover;border-radius:50%;border:1px solid #53665a}.story-npc-heading>div{min-width:0}.story-npc-heading strong,.story-npc-heading small{display:block}.story-npc-heading p{margin:4px 0 0}.story-npc-card>details{margin-top:7px;border-top:1px solid #2c3733;padding-top:6px}.story-npc-card>details>summary{color:#b5c7bd;font-size:8px;cursor:pointer}.story-npc-details{display:grid;gap:6px;margin:8px 0 0}.story-npc-details>div{display:grid;grid-template-columns:minmax(70px,100px) 1fr;gap:8px}.story-npc-details dt{color:#899990;font-size:8px;text-transform:uppercase}.story-npc-details dd{margin:0;color:#bac9c0;font-size:9px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}.story-npc-card pre{max-height:180px;overflow:auto;padding:8px;border-radius:6px;background:#101515;color:#b8c9bf;font-size:8px;white-space:pre-wrap;overflow-wrap:anywhere}\n.story-map-preview{position:relative;min-height:230px;overflow:hidden;border:1px solid #34423c;border-radius:8px;background-color:#111817;background-image:linear-gradient(#ffffff0d 1px,transparent 1px),linear-gradient(90deg,#ffffff0d 1px,transparent 1px);background-size:28px 28px}\n.story-map-pin,.story-map-here{position:absolute;transform:translate(-50%,-50%);display:grid;justify-items:center;gap:3px;max-width:120px;border:0;background:transparent;color:#d6e6dc;text-align:center}.story-map-pin{cursor:pointer}.story-map-pin:disabled{cursor:default}.story-map-pin>span,.story-map-here>span{display:grid;place-items:center;width:24px;height:24px;border:1px solid #78927e;border-radius:50%;background:#1b2b24;color:#cfe1d4}.story-map-pin.selected>span,.story-map-here>span{border-color:#dce9be;background:#506b44;color:white}.story-map-pin small,.story-map-here small{padding:2px 4px;border-radius:4px;background:#121817d9;color:#d1ded5;font-size:7px;line-height:1.25}.story-map-here{z-index:2;color:#f0e8bc}.story-map-here>span{font-size:11px}\n.story-map-locations{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:7px}.story-map-place{display:grid;gap:5px;border:1px solid #33443b;border-radius:8px;background:#151e1b;padding:9px}.story-map-place.selected{border-color:#6c9277;background:#1c2a22}.story-map-place>div{display:flex;align-items:center;justify-content:space-between;gap:8px}.story-map-place strong{font-size:9px;color:#c8d7ce}.story-map-place small{color:#91a097;font-size:7px}.story-map-place p{margin:0;color:#9fafa6;font-size:8px;line-height:1.45}.story-map-place button{justify-self:end;border:1px solid #34423c;border-radius:5px;background:#1a2422;color:#b5c7bd;padding:4px 7px;font-size:8px;cursor:pointer}.story-map-place button:disabled{color:#c9dfce;border-color:#607c68}\n.content-warning{border-inline-start:3px solid #d0a45d;padding:7px 9px;background:#2a2418;color:#f0d4a3;font-size:9px}\n.story-private-turn{border:1px solid #705e38;border-radius:7px;background:#1d1a14;padding:8px}.story-private-turn summary{color:#dbc58d;font-size:9px;cursor:pointer}.story-private-turn p{white-space:pre-wrap}\n.story-asset-row{display:flex;align-items:center;gap:9px;padding:7px;border-top:1px solid #293531;font-size:9px;color:#c3d0c8}\n.story-asset-row img{width:48px;height:48px;object-fit:cover;border-radius:6px;border:1px solid #34423c}\n.story-asset-row small{display:block;color:#819087;font-size:7px;margin-top:3px}\n.story-turn-art{display:block;max-width:min(100%,520px);max-height:360px;object-fit:contain;border-radius:10px;margin:10px auto;border:1px solid #34423c}\n.story-check-result{display:grid;gap:4px;margin:10px 0;padding:10px 12px;border:1px solid #48584e;border-inline-start:3px solid #a9c38c;border-radius:8px;background:#18211d;color:#d8e5dc}\n.story-check-result.failure{border-inline-start-color:#d4a46f}.story-check-result strong{font-size:13px}.story-check-result small{font-size:12px;line-height:1.45;color:#b4c4b8}\n.story-check-math>summary{display:flex;align-items:center;width:max-content;max-width:100%;min-height:44px;padding-inline:4px;color:#b4c4b8;font-size:12px;cursor:pointer}.story-check-math>small{display:block;padding:2px 4px 4px;overflow-wrap:anywhere}\n.manual-check-details{margin-block:10px;border:1px solid #34423c;border-radius:8px;background:#151d1d}\n.manual-check-details>summary{display:flex;align-items:center;min-height:44px;padding:8px 11px;color:#c8d7ce;font-size:12px;cursor:pointer}\n.manual-check-details>p{margin:0;padding:0 11px;font-size:12px;line-height:1.5;color:#aebfb5}\n.manual-check-details .rpg-check-form{margin:10px;border:0;padding:0;background:transparent}\n.story-turn-options{margin-top:8px}.story-turn-options>summary{width:max-content;min-height:44px;padding:8px 10px;color:#aebfb5;font-size:12px;cursor:pointer}\n.story-turn-options .story-turn-actions button{min-height:44px;padding:8px 12px;font-size:12px}\n.rpg-character-details{margin-top:12px;border:1px solid #34423c;border-radius:9px;background:#151d1d}\n.rpg-character-details>summary{display:flex;justify-content:space-between;align-items:center;gap:10px;min-height:48px;padding:9px 12px;color:#d8e5dc;font-size:13px;cursor:pointer}\n.rpg-character-details>summary small{color:#aebfb5;font-size:11px;text-align:end}\n.rpg-character-details-content{display:grid;gap:12px;padding:0 10px 10px}\n.story-character-art{max-width:160px;max-height:210px;object-fit:cover;border-radius:10px}\n.story-turn-edit{display:grid;gap:8px}.story-turn.deleted,.story-turn.superseded{opacity:.55;border-style:dashed}\n.story-history-toggle{margin:8px 0;color:#92a198}\n.story-reader{display:none}.story-reader.is-open{display:block}.story-reader[dir=\"auto\"]{unicode-bidi:plaintext}\n.reader-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;border-bottom:1px solid #35423b;padding-bottom:10px;color:#9baaa2;font-size:9px}\n.reader-metadata{color:#91a49a;font-size:10px}.reader-turn{border-bottom:1px solid #303b36;padding:18px 0;break-inside:avoid}\n.reader-turn h2{font:600 11px Manrope,sans-serif;color:#8fab9a}.reader-turn p{font-size:12px;line-height:1.9;color:#dee8e2;white-space:pre-wrap;overflow-wrap:anywhere}\n.reader-character-art,.reader-scene-art{display:block;max-width:min(100%,620px);max-height:520px;object-fit:contain;margin:12px auto;border-radius:8px}\n@media print{\n  body *{visibility:hidden!important}\n  .story-reader,.story-reader *{visibility:visible!important}\n  .story-reader{display:block!important;position:absolute;inset:0;width:100%;padding:12mm 16mm;background:#fff!important;color:#111!important;font-family:Georgia,\"Times New Roman\",serif}\n  .story-reader h1{font-size:24pt;color:#111}.story-reader h2{font-size:12pt;color:#333}.story-reader p,.reader-metadata{font-size:11pt!important;line-height:1.65!important;color:#111!important}\n  .reader-toolbar,.story-reader>small{display:none!important}.reader-turn{border-color:#ccc}\n  .reader-character-art,.reader-scene-art{max-width:100%;max-height:180mm;page-break-inside:avoid}\n}\n@media(max-width:700px){.story-detail-content{padding-inline:10px}.story-mini-form{padding:9px}.story-turn-actions{gap:4px}.story-turn-actions button{font-size:7px;padding:5px 6px}.story-provider-fields{grid-template-columns:1fr}.story-library-tools{grid-template-columns:1fr}.story-adventure-list-actions{justify-content:flex-start}.story-adventure-card{align-items:flex-start}.story-adventure-card small{line-height:1.5}.story-map-preview{min-height:190px}.story-map-locations{grid-template-columns:1fr}.story-npc-details>div{grid-template-columns:76px 1fr}}\n\n/* Keep NPC authoring details readable and easy to open with a pointer or keyboard. */\n.story-npc-card>details>summary{display:inline-flex;align-items:center;min-height:40px;padding:5px 7px;font-size:12px;line-height:1.4}\n.story-npc-card>details>summary:focus-visible{outline:2px solid #90b596;outline-offset:2px;border-radius:4px}\n.story-npc-heading strong,.story-npc-section-label{font-size:13px;color:#c8d7ce}\n.story-npc-card small,.story-npc-card p{font-size:12px;line-height:1.55}\n.story-npc-details{gap:9px}\n.story-npc-details>div{grid-template-columns:minmax(105px,0.35fr) minmax(0,1fr);gap:10px}\n.story-npc-details dt{font-size:11px;text-transform:none}\n.story-npc-details dd{font-size:12px;line-height:1.6}\n.story-npc-details-nested{margin-top:5px}\n.story-profile-value-list{display:grid;gap:5px;margin:0;padding-inline-start:18px}\n.story-npc-section-label{display:block;margin-top:12px}\n.story-npc-private-notes{margin-top:8px;padding:9px 10px;border-inline-start:2px solid #ad9e79;background:#1d1a14;color:#d4c79f}\n.story-npc-private-notes strong{font-size:12px}\n.story-npc-private-notes p{margin:4px 0 0;color:#d4c79f}\n@media(max-width:700px){.story-npc-details>div{grid-template-columns:minmax(92px,0.4fr) minmax(0,1fr)}}\n\n/* Keep the active narrative readable while the next-action composer stays close. */\n#root .story-canvas {\n  display: grid;\n  align-content: start;\n  gap: 1rem;\n  min-height: 0;\n  overflow: visible;\n}\n\n#root .story-turn-list {\n  max-height: min(60vh, 58rem);\n  min-height: 12rem;\n  margin: 0;\n  overflow-anchor: none;\n  overscroll-behavior: contain;\n}\n\n#root .story-turn-list:has(> .story-placeholder) {\n  max-height: 24rem;\n  min-height: 12rem;\n  padding-block-end: 0;\n}\n\n#root .story-turn-list > .story-placeholder {\n  margin-block: 2rem;\n}\n\n#root .story-load-earlier-turns {\n  display: flex;\n  width: min(100%, 76ch);\n  min-height: var(--target-size, 2.75rem);\n  margin: 0 auto 1rem;\n  padding-inline: 1rem;\n  text-align: center;\n}\n\n#root .story-turn {\n  width: min(100%, 76ch);\n  margin-inline: auto;\n}\n\n#root .story-transcript-frame {\n  position: relative;\n  min-width: 0;\n}\n\n#root .story-hub-disclosure:not([open]) {\n  padding-block: 0.5rem;\n  padding-inline: 1rem;\n}\n\n#root .story-hub-disclosure:not([open]) > .story-hub-summary {\n  min-height: 2.75rem;\n  margin: 0;\n  padding-block: 0.25rem;\n}\n\n@media (min-width: 901px) {\n  #root .story-turn-list {\n    padding-bottom: max(0px, calc(43rem - 40vh));\n  }\n}\n\n#root .story-jump-latest {\n  position: absolute;\n  right: 0.75rem;\n  bottom: 0.75rem;\n  z-index: 2;\n  box-shadow: 0 3px 16px #0008;\n}\n\n#root .story-compose-form {\n  position: sticky;\n  bottom: 0;\n  z-index: 3;\n  margin: 0 -17px -17px;\n  padding: 12px 17px 16px;\n  border-top: 1px solid #34423c;\n  background: linear-gradient(180deg, #161d1fea, #141a1b 38%);\n  backdrop-filter: blur(14px);\n}\n\n#root .story-compose-form .story-direction-label {\n  margin: 0 0 0.5rem;\n}\n\n@media (max-width: 520px) {\n  #root .story-compose-form {\n    margin-right: -10px;\n    margin-left: -10px;\n    padding-right: 10px;\n    padding-left: 10px;\n  }\n}\n\n@media (max-height: 700px) {\n  #root .story-turn-list {\n    max-height: min(44vh, 24rem);\n    min-height: 10rem;\n    padding-block-end: 0;\n  }\n\n  #root .story-compose-form {\n    position: static;\n    backdrop-filter: none;\n  }\n}\n\n@media (max-width: 900px) {\n  #root .story-compose-form {\n    position: static;\n  }\n}\n"],["STYLE",{},":root {\n  --type-reading: 1.125rem;\n  --type-body: 1rem;\n  --type-secondary: 0.875rem;\n  --target-size: 2.75rem;\n  --focus-ring: #a9dfbf;\n}\n\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n#root {\n  font-size: var(--type-body);\n}\n\nbody {\n  min-width: 320px;\n}\n\n#root\n  :is(\n    .eyebrow,\n    .field-label,\n    .field-note,\n    .provider-note,\n    .control-choice,\n    .empty-hint,\n    .privacy-tag,\n    .story-turn-label,\n    .story-context-details summary,\n    .story-private-turn summary,\n    .story-turn-options summary,\n    .manual-check-details summary\n  ) {\n  font-size: var(--type-secondary);\n  line-height: 1.5;\n}\n\n#root small,\n#root label,\n#root summary,\n#root .page-heading p,\n#root .panel-heading p {\n  font-size: var(--type-secondary);\n  line-height: 1.5;\n}\n\n#root .page-content p {\n  font-size: var(--type-secondary);\n  line-height: 1.65;\n}\n\n#root .story-turn p,\n#root .story-reader p {\n  font-size: var(--type-reading);\n  line-height: 1.75;\n}\n\n#root\n  .story-hub\n  :is(\n    .story-hub-title strong,\n    .story-hub-title small,\n    .story-adventure-list-heading strong,\n    .story-adventure-card strong,\n    .story-adventure-card small,\n    .story-branch-note\n  ),\n#root .story-detail-content :is(span, strong, b, dt, dd, p, pre),\n#root .rpg-stat-list :is(span, strong, b),\n#root .rpg-tracker-list :is(span, strong, b),\n#root .story-npc-details :is(dt, dd),\n#root .rpg-proposal :is(strong, small),\n#root .rpg-location strong,\n#root .story-turn-label span,\n#root .story-context-fact strong,\n#root .story-check-result strong,\n#root .story-npc-heading strong,\n#root .story-npc-section-label,\n#root .story-setup-progress li span {\n  font-size: var(--type-secondary);\n  line-height: 1.55;\n}\n\n#root .story-detail-panel > summary::after,\n#root .story-hub-setup > summary::after {\n  font-size: var(--type-secondary);\n}\n\n#root .nav-item b,\n#root .breadcrumbs,\n#root .top-actions,\n#root .project-options > summary,\n#root .sidebar-more-tools > summary,\n#root legend {\n  font-size: var(--type-secondary);\n}\n\n#root input:not([type=\"checkbox\"]):not([type=\"radio\"]):not([type=\"hidden\"]),\n#root select,\n#root textarea {\n  min-height: var(--target-size);\n  font-size: var(--type-body);\n}\n\n#root textarea {\n  line-height: 1.55;\n}\n\n#root pre {\n  font-size: var(--type-secondary);\n  line-height: 1.5;\n  overflow-wrap: anywhere;\n}\n\n#root input[type=\"checkbox\"],\n#root input[type=\"radio\"] {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n#root label:has(> input[type=\"checkbox\"]),\n#root label:has(> input[type=\"radio\"]) {\n  min-height: var(--target-size);\n  padding-block: 0.4rem;\n}\n\n#root button,\n#root summary {\n  min-height: var(--target-size);\n}\n\n#root button {\n  font-size: var(--type-secondary);\n  line-height: 1.4;\n}\n\n#root\n  :is(button, a, input, select, textarea, summary, [tabindex]):focus-visible {\n  outline: 3px solid var(--focus-ring);\n  outline-offset: 2px;\n}\n\n#root .review-row strong {\n  min-width: 0;\n  overflow-wrap: anywhere;\n  white-space: normal;\n}\n\n#root .review-row:focus {\n  outline: 3px solid var(--focus-ring);\n  outline-offset: 3px;\n}\n\n#root .scenario-evidence-pickers > .primary-button {\n  margin-left: auto;\n  margin-inline-start: auto;\n}\n\n#root .story-hub-disclosure > .story-hub-summary,\n#root .story-secondary-import > summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  min-height: 3.5rem;\n  cursor: pointer;\n  list-style: none;\n}\n\n#root .story-hub-disclosure > .story-hub-summary::-webkit-details-marker,\n#root .story-secondary-import > summary::-webkit-details-marker {\n  display: none;\n}\n\n#root .story-hub-disclosure > .story-hub-summary::after,\n#root .story-secondary-import > summary::after {\n  content: \"▾\";\n  flex: none;\n  font-size: 1.125rem;\n}\n\n#root .story-hub-disclosure:not([open]) > .story-hub-summary::after,\n#root .story-secondary-import:not([open]) > summary::after {\n  content: \"▸\";\n}\n\n#root .story-hub-disclosure > .story-hub-summary > div {\n  min-width: 0;\n}\n\n#root .story-hub-summary h2 {\n  margin: 0;\n  font-size: 1rem;\n}\n\n#root .story-hub-summary p {\n  margin: 0;\n  color: #aebfb5;\n}\n\n#root .story-secondary-import {\n  margin-block: 1rem;\n  border: 1px solid #34423c;\n  border-radius: 0.75rem;\n  background: #151d1d;\n}\n\n#root .story-grid-chat-focus {\n  grid-template-columns: minmax(0, 1fr);\n}\n\n#root .story-grid-tools-open {\n  grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);\n  align-items: start;\n}\n\n#root\n  .story-hub-content:has(> #story-adventure-setup[open])\n  > :not(#story-adventure-setup) {\n  display: none !important;\n}\n\n#root .story-grid:has(#story-adventure-setup[open]) + .story-secondary-import {\n  display: none !important;\n}\n\n#root .story-heading-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 0.5rem;\n  flex-wrap: wrap;\n}\n\n#root .story-heading-actions button {\n  min-height: var(--target-size);\n  white-space: normal;\n}\n\n#root .story-hub-content {\n  display: grid;\n  align-content: start;\n  gap: 0.85rem;\n  min-width: 0;\n}\n\n#root .story-hub-content > * {\n  min-width: 0;\n  margin-block: 0;\n}\n\n#root .story-adventure-list-heading {\n  align-items: flex-start;\n  gap: 1rem;\n  flex-wrap: wrap;\n}\n\n#root .story-adventure-list-actions {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  flex-wrap: wrap;\n}\n\n#root .story-tools-drawer[hidden],\n#root .story-tool-panel[hidden] {\n  display: none !important;\n}\n\n#root .story-tools-drawer {\n  position: sticky;\n  top: 1rem;\n  align-self: start;\n  max-height: calc(100vh - 2rem);\n  overflow: auto;\n  min-width: 0;\n  margin: 0;\n  padding: 1rem;\n  overscroll-behavior: contain;\n  scrollbar-gutter: stable;\n}\n\n#root .story-tools-heading {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 0.75rem;\n  margin-bottom: 0.75rem;\n}\n\n#root .story-tools-heading h2,\n#root .story-tools-heading p {\n  margin: 0;\n}\n\n#root .story-tools-heading p {\n  margin-top: 0.25rem;\n  color: #aebfb5;\n}\n\n#root .story-tool-tabs {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(5.25rem, 1fr));\n  gap: 0.4rem;\n  position: sticky;\n  top: 0;\n  z-index: 2;\n  padding: 0.25rem 0 0.75rem;\n  background: #171e20;\n  border-bottom: 1px solid #34423c;\n}\n\n#root .story-tool-tabs button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.4rem;\n  width: 100%;\n  min-height: var(--target-size);\n  border: 1px solid #34423c;\n  border-radius: 0.65rem;\n  padding: 0.4rem 0.55rem;\n  background: #151d1d;\n  color: #aebfb5;\n  text-align: center;\n}\n\n#root .story-tool-tabs button.selected,\n#root .story-tool-tabs button[aria-selected=\"true\"] {\n  border-color: #6b9a7b;\n  background: #20352a;\n  color: #d3ead9;\n}\n\n#root .story-side-panels,\n#root .story-more-tools-panel {\n  min-width: 0;\n}\n\n#root .story-side-panels > .story-more-tools-panel {\n  display: grid;\n  gap: 0.75rem;\n}\n\n#root .story-more-tools-panel > .panel,\n#root .story-history-revisions .history-panel,\n#root .story-tool-panel[role=\"tabpanel\"] > .panel-heading {\n  margin-top: 0;\n}\n\n#root .story-more-tools-panel > .panel,\n#root .story-tool-panel[role=\"tabpanel\"] {\n  min-width: 0;\n  margin: 0;\n}\n\n#root .story-more-tools-panel > .panel {\n  padding: 0.9rem;\n}\n\n#root .story-history-switch {\n  display: grid;\n  gap: 0.4rem;\n  margin: 0.75rem 0;\n}\n\n#root .story-session-actions.story-history-actions {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  flex-wrap: wrap;\n  margin: 0.75rem 0;\n}\n\n#root .story-history-export-options {\n  display: grid;\n  gap: 0.65rem;\n  margin: 0.75rem 0;\n  padding: 0.75rem;\n  border: 1px solid #34423c;\n  border-radius: 0.75rem;\n}\n\n#root .story-history-export-options legend {\n  padding-inline: 0.35rem;\n  color: #c1d0c8;\n}\n\n#root .story-history-export-options .field-note {\n  margin: 0;\n}\n\n#root .story-history-revisions {\n  margin-top: 0.75rem;\n  border: 1px solid #34423c;\n  border-radius: 0.75rem;\n  padding: 0.65rem 0.75rem;\n}\n\n#root .story-history-revisions > summary {\n  cursor: pointer;\n  color: #c1d0c8;\n}\n\n#root .story-branch-revision-history {\n  margin: 0.75rem 0 0;\n  padding: 0.75rem;\n  border: 1px solid #34423c;\n  border-radius: 0.7rem;\n  background: #151d1d;\n}\n\n#root .story-branch-revision-history .panel-heading {\n  margin: 0 0 0.65rem;\n}\n\n#root .story-branch-revision-history .panel-heading h3,\n#root .story-branch-revision-history .panel-heading p {\n  margin: 0;\n}\n\n#root .story-revision-picker {\n  display: grid;\n  gap: 0.4rem;\n  max-height: 15rem;\n  overflow: auto;\n  margin: 0;\n  padding: 0.15rem;\n  list-style: none;\n}\n\n#root .story-revision-picker button {\n  display: grid;\n  justify-items: start;\n  gap: 0.2rem;\n  width: 100%;\n  min-width: 0;\n  min-height: var(--target-size);\n  padding: 0.5rem 0.65rem;\n  border: 1px solid #34423c;\n  border-radius: 0.55rem;\n  background: #111819;\n  color: #c1d0c8;\n  text-align: start;\n}\n\n#root .story-revision-picker button[aria-current=\"true\"] {\n  border-color: #6b9a7b;\n  background: #20352a;\n}\n\n#root .story-revision-picker button strong,\n#root .story-revision-picker button small {\n  max-width: 100%;\n  overflow-wrap: anywhere;\n}\n\n#root .story-revision-picker button small {\n  color: #91aa9b;\n}\n\n#root .story-revision-inspector {\n  margin-top: 0.7rem;\n  padding: 0.65rem;\n  border: 1px so